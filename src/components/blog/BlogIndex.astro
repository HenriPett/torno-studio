---
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import CtaBand from '../ds/CtaBand.astro';
import Section from '../ds/Section.astro';
import SectionHeader from '../ds/SectionHeader.astro';
import { publicBlogEntries } from '../../lib/blog';
import { site } from '../../config/site';
import { pathFor } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';
interface Props { locale: Locale }
const {locale}=Astro.props;
const en=locale==='en';
const articles=await publicBlogEntries(locale);
const description=en?'Notes on custom software, product decisions, and getting systems into production.':'Textos sobre software sob medida, decisões de produto e o trabalho de colocar sistemas em produção.';
---
<Base locale={locale} routeId="blog" title={en?'Custom software and integrations blog | {brand}':'Blog de software sob medida e integrações | {brand}'} description={description}>
  {articles.length>0 && <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'ItemList',url:new URL(pathFor('blog',locale),'https://tornostudio.com').href,numberOfItems:articles.length,itemListElement:articles.map(({meta},index)=>({'@type':'ListItem',position:index+1,url:meta.data.canonical_url,name:meta.data.h1}))}).replace(/</g, '\\u003c')} />}
  <Header locale={locale} routeId="blog" />
  <main id="conteudo" tabindex="-1" class="blog-index">
    <Section labelledby="blog-title" tight reveal={false} class="blog-hero">
      <SectionHeader as="h1" id="blog-title" size="lg" eyebrow="Blog" title={en?'Custom software and integrations':'Software sob medida e integrações'} lead={description} />
      <p class="meta blog-authors">{en?'Articles by':'Artigos escritos por'} <a class="link" rel="author" href={pathFor('author',locale)}>Henrique Pett</a>, {en?`founder and technical lead of ${site.organizationName}`:`fundador e líder técnico da ${site.organizationName}`}. {en?'Practical guidance for defining scope, assessing integrations and checking a software delivery.':'Orientações práticas para definir escopo, avaliar integrações e conferir uma entrega de software.'}</p>
    </Section>
    <Section variant="muted" tight label={en?'Articles':'Artigos'} reveal={false} class="blog-list">
      {articles.length ? <>
        <p class="caption blog-count">{articles.length} {en?(articles.length===1?'article':'articles'):(articles.length===1?'artigo':'artigos')}</p>
        <ul class="articles" role="list" data-reveal-stagger>{articles.map(({meta},index)=><li class:list={['article-card', index===0 && 'article-card--featured']}>
          <h2 class:list={[index===0?'title-lg':'title','article-card__title']}><a class="article-card__link" href={meta.path}>{meta.data.h1}</a></h2>
          <p class="article-card__summary">{meta.data.summary}</p>
          <span class="article-card__more" aria-hidden="true">{en?'Read':'Ler artigo'}</span>
        </li>)}</ul>
      </> : <div class="empty"><p class="lead">{en?'No articles are available in English yet.':'Ainda não há artigos publicados em português.'}</p>{en && <p class="empty__link"><a class="link link--arrow link--target" href="/blog/" hreflang="pt-BR" lang="pt-BR">Ler o blog em português</a></p>}</div>}
    </Section>
    <CtaBand locale={locale} id="blog-cta" title={en?'Have a system in your operation to discuss?':'Tem um sistema da operação para discutir?'} text={en?'In a free 45-minute first call we look at the problem, the systems involved and who decides.':'Na conversa inicial, de 45 minutos e sem custo, olhamos o problema, os sistemas envolvidos e quem decide.'} />
  </main>
  <Footer locale={locale} routeId="blog" />
</Base>
<style>
.blog-authors { margin-block-start:var(--space-5); max-inline-size:60ch; font-weight:var(--weight-regular); }
.blog-authors a { color:var(--color-text); }
.blog-count { margin-block-end:var(--space-4); }
.articles { display:grid; gap:var(--space-gutter); padding:0; list-style:none; }
.article-card { position:relative; display:flex; flex-direction:column; gap:var(--space-3); padding:var(--space-5); background:var(--color-surface); border-radius:var(--radius-lg); transition:transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out); }
.article-card__title { text-wrap:balance; }
.article-card__link { color:var(--color-text); text-decoration:none; }
/* O link cobre o card inteiro; o foco desenha o anel no card. */
.article-card__link::after { content:""; position:absolute; inset:0; border-radius:inherit; }
.article-card__link:focus-visible { outline:none; }
.article-card:has(.article-card__link:focus-visible) { outline:var(--focus-ring); outline-offset:var(--focus-offset); }
.article-card__summary { color:var(--color-text-muted); font-size:var(--text-sm); line-height:1.5; display:-webkit-box; -webkit-line-clamp:4; -webkit-box-orient:vertical; overflow:hidden; }
.article-card__more { margin-block-start:auto; padding-block-start:var(--space-2); font-size:var(--text-sm); font-weight:var(--weight-medium); color:var(--color-accent-text); }
.article-card__more::after { content:" \203A"; }
.article-card--featured { padding:var(--space-6); }
.article-card--featured .article-card__summary { font-size:var(--text-base); -webkit-line-clamp:5; }
@media (hover:hover) {
  .article-card:hover { transform:translateY(-2px); box-shadow:var(--shadow-md); }
  .article-card:hover .article-card__link { text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:.2em; }
}
@media (prefers-reduced-motion:reduce) { .article-card { transition:none; } .article-card:hover { transform:none; } }
@media (min-width:40em) { .articles { grid-template-columns:repeat(2,minmax(0,1fr)); } .article-card--featured { grid-column:1 / -1; } }
@media (min-width:64em) {
  .articles { grid-template-columns:repeat(3,minmax(0,1fr)); }
  .article-card { padding:var(--space-6); }
  .article-card--featured { grid-column:span 2; padding:var(--space-7); justify-content:flex-end; min-block-size:22rem; }
}
.empty { display:grid; gap:var(--space-4); }
.empty .lead { color:var(--color-text); max-inline-size:none; }
</style>
