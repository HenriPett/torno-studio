---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import BookingCta from '../ui/BookingCta.astro';
import { blogIndexPath, type BlogEntry } from '../../config/blog.mjs';
interface Props { meta: BlogEntry; entry: CollectionEntry<'blog'> }
const {meta,entry}=Astro.props;
const {Content}=await render(entry);
const d=meta.data;
const en=meta.locale==='en';
const languageHref=meta.alternates.find(a=>a.hreflang!=='x-default' && a.hreflang!==meta.locale)?.href ?? null;
const date=(value:string)=>new Intl.DateTimeFormat(meta.locale,{dateStyle:'long',timeZone:'UTC'}).format(new Date(value));
const schema={ '@context':'https://schema.org','@type':d.first_published_at ? 'BlogPosting' : 'WebPage',url:d.canonical_url,mainEntityOfPage:d.canonical_url,headline:d.h1,description:d.summary,inLanguage:meta.locale,author:{'@type':'Person',name:d.author_name},...(d.first_published_at?{datePublished:d.first_published_at}:{}),...(d.last_substantive_update_at?{dateModified:d.last_substantive_update_at}:{}) };
---
<Base locale={meta.locale} title={`${d.h1} | {brand}`} description={d.summary} editorial={{canonical:d.canonical_url,alternates:meta.alternates,schema,article:true}}>
  <Header locale={meta.locale} routeId="blog" languageHref={languageHref} />
  <main id="conteudo" tabindex="-1" class="container blog-article">
    <nav class="breadcrumb" aria-label={en?'Breadcrumb':'Navegação estrutural'}><ol>
      <li><a class="link link--target" href={en?'/en/':'/'}>{en?'Home':'Início'}</a></li>
      <li><span aria-hidden="true">/</span> <a class="link link--target" href={blogIndexPath(meta.locale)}>Blog</a></li>
    </ol></nav>
    <article>
      <header class="article-heading"><h1>{d.h1}</h1><p class="lead">{d.summary}</p>
        {d.author_name && d.author_basis && <p class="meta">{d.author_name}</p>}
        {d.first_published_at && <p class="meta">{en?'Published on':'Publicado em'} <time datetime={d.first_published_at}>{date(d.first_published_at)}</time></p>}
        {d.last_substantive_update_at && <p class="meta">{en?'Updated on':'Atualizado em'} <time datetime={d.last_substantive_update_at}>{date(d.last_substantive_update_at)}</time></p>}
      </header>
      <div class="prose"><Content /></div>
    </article>
    <section class="article-cta" aria-labelledby="article-cta-title">
      <h2 id="article-cta-title">{en?'Want to discuss your project?':'Quer discutir o seu projeto?'}</h2>
      <p>{en?"Share the context; I'll help define the scope and next step.":'Traga o contexto; eu ajudo a definir o escopo e o próximo passo.'}</p>
      <BookingCta locale={meta.locale}>{en?'Book a 45-min scoping call (free)':'Agendar diagnóstico (45 min, grátis)'}</BookingCta>
    </section>
    <a class="link link--target return" href={blogIndexPath(meta.locale)}>{en?'Back to the blog':'Voltar ao blog'} →</a>
  </main>
  <Footer locale={meta.locale} routeId="blog" languageHref={languageHref} />
</Base>
<style>
.blog-article { max-inline-size:54rem; padding-block:var(--space-6) var(--space-8); }
.breadcrumb ol { display:flex; flex-wrap:wrap; align-items:center; gap:var(--space-3); list-style:none; padding:0; }
.breadcrumb li { display:flex; align-items:center; gap:var(--space-3); }
.article-heading { margin-block:var(--space-5) var(--space-7); }
h1 { font-size:var(--text-3xl); line-height:var(--leading-tight); max-inline-size:24ch; }
.article-heading p { margin-block-start:var(--space-4); max-inline-size:var(--measure); }
.prose { max-inline-size:var(--measure); overflow-wrap:anywhere; }
.prose :global(* + *) { margin-block-start:var(--space-4); }
.prose :global(h2) { font-size:var(--text-2xl); margin-block-start:var(--space-7); }
.prose :global(h3) { font-size:var(--text-xl); margin-block-start:var(--space-6); }
.prose :global(h2),.prose :global(h3) { scroll-margin-top:calc(var(--header-height) + var(--space-4)); }
.prose :global(a) { color:var(--color-accent-text); text-decoration:underline; }
.prose :global(pre) { overflow-x:auto; padding:var(--space-4); background:var(--color-surface-sunken); }
.prose :global(pre:focus-visible),.prose :global(.blog-table-scroll:focus-visible) { outline:var(--focus-ring); outline-offset:var(--focus-offset); }
.prose :global(.blog-table-scroll) { max-inline-size:100%; overflow-x:auto; border:1px solid var(--color-border); border-radius:var(--radius-md); }
.prose :global(.blog-table-hint) { font-size:var(--text-sm); color:var(--color-text-muted); }
.prose :global(table) { display:table; inline-size:100%; min-inline-size:36rem; border-collapse:collapse; overflow-wrap:normal; }
.prose :global(th),.prose :global(td) { min-inline-size:10rem; max-inline-size:28rem; padding:var(--space-3); text-align:start; vertical-align:top; white-space:normal; word-break:normal; overflow-wrap:break-word; border-block-end:1px solid var(--color-border); }
.prose :global(img) { max-inline-size:100%; height:auto; }
.prose :global(ul),.prose :global(ol) { padding-inline-start:var(--space-5); }
.prose :global(blockquote) { border-inline-start:3px solid var(--color-accent-text); padding:var(--space-4); }
.article-cta { margin-block-start:var(--space-8); padding:var(--space-5); background:var(--color-accent-subtle); border-radius:var(--radius-md); }
.article-cta h2 { font-size:var(--text-xl); }
.article-cta p { margin-block:var(--space-4); }
.return { margin-block-start:var(--space-6); }
@media(min-width:40em){.blog-article{padding-block-start:var(--space-7);}}
</style>
