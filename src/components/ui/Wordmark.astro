---
/**
 * Wordmark (DESIGN §6.1): só texto, de SITE_BRAND. Funciona de 2 a ~32 caracteres:
 * até 2 linhas abaixo de 1200 px, 1 linha acima. Nunca largura fixa nem fonte calculada pelo tamanho.
 */
import { SITE_BRAND } from '../../config/site';

interface Props {
  /** Sem href, a marca é texto (landing de campanha: um link para a home seria uma saída, DESIGN §14.2). */
  href?: string | undefined;
}

const { href } = Astro.props;
const Tag = href ? 'a' : 'span';
const placeholder = import.meta.env.DEV && SITE_BRAND.includes('[');
---

<Tag class="wordmark" href={href} data-brand data-placeholder={placeholder || undefined}
  ><span class="wordmark__text">{SITE_BRAND}</span></Tag
>

<style>
  /* O link tem alvo ≥ 44 px; o texto interno é que limita a 2 linhas. */
  .wordmark {
    display: flex;
    align-items: center;
    min-inline-size: var(--tap-min);
    min-block-size: var(--tap-min);
    font-size: var(--text-brand);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-brand);
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .wordmark__text {
    min-inline-size: 0;
    overflow-wrap: anywhere;
    text-wrap: balance;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (hover: hover) {
    a.wordmark:hover {
      color: var(--color-accent-text);
    }
  }

  @media (min-width: 75em) {
    .wordmark__text {
      display: block;
      white-space: nowrap;
      overflow: visible;
    }
  }
</style>
