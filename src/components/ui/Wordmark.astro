---
/**
 * Wordmark tipográfico (DESIGN-2026-11 §7): só texto, de SITE_BRAND, Inter 700 com tracking fechado.
 * Sem monograma. Funciona de 2 a ~32 caracteres (até 2 linhas no celular, 1 acima de 1200 px).
 * Classes `wordmark`/`wordmark__text` e `data-brand` são usadas pelos testes.
 */
import { SITE_BRAND } from '../../config/site';

interface Props {
  /** Sem href, a marca é texto (landing de campanha: um link para a home seria uma saída). */
  href?: string | undefined;
  size?: 'md' | 'lg';
}

const { href, size = 'md' } = Astro.props;
const Tag = href ? 'a' : 'span';
const placeholder = import.meta.env.DEV && SITE_BRAND.includes('[');
---

<Tag class:list={['wordmark', `wordmark--${size}`]} href={href} data-brand data-placeholder={placeholder || undefined}
  ><span class="wordmark__text">{SITE_BRAND}</span></Tag
>

<style>
  /* O link tem alvo ≥ 44 px; o texto interno é que limita a 2 linhas. */
  .wordmark {
    display: flex;
    align-items: center;
    min-inline-size: var(--tap-min);
    min-block-size: var(--tap-min);
    font-size: var(--text-brand);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-brand);
    color: var(--color-text);
    text-decoration: none;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .wordmark--lg {
    font-size: var(--text-title-lg);
  }

  .wordmark__text {
    min-inline-size: 0;
    overflow-wrap: anywhere;
    text-wrap: balance;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (hover: hover) {
    a.wordmark:hover {
      opacity: 0.72;
    }
  }

  @media (min-width: 75em) {
    .wordmark__text {
      display: block;
      white-space: nowrap;
      overflow: visible;
    }
  }
</style>
