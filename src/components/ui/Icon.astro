---
/**
 * Ícones próprios em SVG inline (DESIGN §6.9): traço 1.5, sem preenchimento, currentColor.
 * Sempre decorativos (aria-hidden); o texto ao lado dá o significado.
 */
const paths = {
  // Problema
  spreadsheet: '<rect x="3.75" y="3.75" width="16.5" height="16.5" rx="1.5"/><path d="M3.75 9.25h16.5M3.75 14.75h16.5M9.25 3.75v16.5M14.75 3.75v16.5"/>',
  clipboard: '<rect x="5.25" y="4.5" width="13.5" height="16.5" rx="1.5"/><path d="M9 4.5V3.75A.75.75 0 0 1 9.75 3h4.5a.75.75 0 0 1 .75.75v.75M9 10.5h6M9 14h6M9 17.5h3.5"/>',
  browser: '<rect x="3" y="4.5" width="18" height="15" rx="1.5"/><path d="M3 9h18M6.25 6.75h.01M8.75 6.75h.01"/>',
  graph: '<circle cx="6" cy="17" r="2.25"/><circle cx="18" cy="17" r="2.25"/><circle cx="12" cy="6" r="2.25"/><path d="M10.9 8l-3.8 6.9M13.1 8l3.8 6.9M8.25 17h7.5"/>',
  personDashed: '<circle cx="12" cy="8" r="3.75" stroke-dasharray="2.5 2"/><path d="M4.5 20.25a7.5 7.5 0 0 1 15 0" stroke-dasharray="2.5 2"/>',
  layers: '<path d="M12 3.75l8.25 4.5L12 12.75 3.75 8.25 12 3.75z"/><path d="M3.75 12L12 16.5 20.25 12"/><path d="M3.75 15.75L12 20.25l8.25-4.5"/>',
  wrench: '<path d="M14.7 6.3a4.5 4.5 0 0 0-5.9 5.6L3.9 16.8a1.9 1.9 0 0 0 2.7 2.7l4.9-4.9a4.5 4.5 0 0 0 5.6-5.9l-2.7 2.7-2.4-.6-.6-2.4 2.7-2.7z"/>',
  // Garantias
  shield: '<path d="M12 3l7.5 3v5.25c0 4.5-3.2 8.3-7.5 9.75-4.3-1.45-7.5-5.25-7.5-9.75V6L12 3z"/><path d="M9 12l2.25 2.25L15.5 10"/>',
  document: '<path d="M6.75 3h7.5l4.5 4.5v12.75a.75.75 0 0 1-.75.75H6.75a.75.75 0 0 1-.75-.75V3.75A.75.75 0 0 1 6.75 3z"/><path d="M14.25 3v4.5h4.5M9 12h6M9 15.5h6M9 19h3"/>',
  cloudKey: '<path d="M7 18a4.5 4.5 0 0 1-.4-8.98 6 6 0 0 1 11.6 1.48A3.75 3.75 0 0 1 17.25 18H7z"/><circle cx="10" cy="13.75" r="1.5"/><path d="M11.5 13.75h3.5M14 13.75v1.5"/>',
  milestones: '<path d="M3 12h18"/><circle cx="5.25" cy="12" r="2.25"/><circle cx="12" cy="12" r="2.25"/><circle cx="18.75" cy="12" r="2.25"/>',
  one: '<circle cx="12" cy="12" r="8.25"/><path d="M10.5 9.5L12.5 8v8.25M10.5 16.25h4"/>',
  demo: '<rect x="3" y="4.5" width="18" height="12" rx="1.5"/><path d="M8.25 20.25h7.5M12 16.5v3.75M10.5 8.25l3.75 2.25-3.75 2.25v-4.5z"/>',
  // Método
  terminal: '<rect x="3" y="4.5" width="18" height="15" rx="1.5"/><path d="M7 9.5l3 2.5-3 2.5M12.5 15h4.5"/>',
  check: '<rect x="3.75" y="3.75" width="16.5" height="16.5" rx="1.5"/><path d="M8.25 12.25l2.5 2.5 5-5.25"/>',
  gear: '<path d="M18.44 10.56 L20.91 10.74 L20.91 13.26 L18.44 13.44 L17.57 15.54 L19.19 17.41 L17.41 19.19 L15.54 17.57 L13.44 18.44 L13.26 20.91 L10.74 20.91 L10.56 18.44 L8.46 17.57 L6.59 19.19 L4.81 17.41 L6.43 15.54 L5.56 13.44 L3.09 13.26 L3.09 10.74 L5.56 10.56 L6.43 8.46 L4.81 6.59 L6.59 4.81 L8.46 6.43 L10.56 5.56 L10.74 3.09 L13.26 3.09 L13.44 5.56 L15.54 6.43 L17.41 4.81 L19.19 6.59 L17.57 8.46Z"/><circle cx="12" cy="12" r="2.75"/>',
  network: '<circle cx="12" cy="12" r="2.25"/><circle cx="5.25" cy="6" r="2.25"/><circle cx="18.75" cy="18" r="2.25"/><path d="M7 7.6l3.3 2.9M13.7 13.5l3.3 2.9"/>',
  // UI
  theme: '<circle cx="12" cy="12" r="8.25"/><path d="M12 3.75a8.25 8.25 0 0 1 0 16.5V3.75z" fill="currentColor"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  checkCircle: '<circle cx="12" cy="12" r="8.25"/><path d="M8.5 12.25l2.5 2.5 4.75-5"/>',
  tick: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  arrowRight: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  external: '<path d="M8 16L16 8M9.5 8H16v6.5"/>',
} as const;

export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'icon' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
