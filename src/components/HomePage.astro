---
/**
 * Home (/ e /en/) para indústrias de médio e grande porte (estratégia 2026-11 §2, §4 e §6; DESIGN-2026-11 §8).
 * Mesma estrutura nos dois idiomas; conteúdo em src/content/home.ts e institucional.ts.
 * Ritmo de fundos: hero (com a demo) → muted (fluxo) → default (adoção) → muted (áreas) → default (resultados) → muted →
 * default (etapas) → muted → inverse → default → muted → CTA inverse. Uma ilustração por "momento" (DESIGN §6.13).
 * Regras: nenhum setor citado por nome, nenhum link para /para/, sem preço, mocks e exemplos rotulados.
 */
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Section from './ds/Section.astro';
import SectionHeader from './ds/SectionHeader.astro';
import FeatureGrid from './ds/FeatureGrid.astro';
import Steps from './ds/Steps.astro';
import StatGrid from './ds/StatGrid.astro';
import Faq from './ds/Faq.astro';
import CtaBand from './ds/CtaBand.astro';
import Pill from './ds/Pill.astro';
import AskMock from './ds/mocks/AskMock.astro';
import PanelMock from './ds/mocks/PanelMock.astro';
import SourcesFlow from './ds/illos/SourcesFlow.astro';
import AdoptionBars from './ds/illos/AdoptionBars.astro';
import FactoryDots from './ds/illos/FactoryDots.astro';
import ImpactCards from './ds/illos/ImpactCards.astro';
import BookingCta from './ui/BookingCta.astro';
import CaseCards from './institucional/CaseCards.astro';
import { home, MUNDOLOGISTICA_URL } from '../content/home';
import { etapas, estrutura } from '../content/institucional';
import { getChrome } from '../content/chrome';
import { getCopy, pathFor, type Locale } from '../lib/i18n';
import { outOfTen } from './ds/illos/kinds';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const c = home[locale];
const ids = c.ids;
const cta = getChrome(locale).common.bookingCta;
const howWeWork = pathFor('howWeWork', locale);
// Rótulos de interface das ilustrações (o conteúdo vem de home.ts).
const ui = {
  'pt-BR': {
    core: 'Cérebro da operação',
    coreNote: 'Com permissões por área e a fonte em cada resposta',
    outTitle: 'Respostas para cada área',
    useAI: 'usam IA',
    scope: { industria: 'Indústria', global: 'Estudo global' },
    adoptionId: 'ia-na-industria',
    impactId: 'resultados',
  },
  en: {
    core: 'Operations brain',
    coreNote: 'With permissions by area and the source in every answer',
    outTitle: 'Answers for each area',
    useAI: 'use AI',
    scope: { industria: 'Manufacturing', global: 'Global study' },
    adoptionId: 'ai-in-manufacturing',
    impactId: 'results',
  },
}[locale];
const sourceWord = getChrome(locale).common.source;
// Áreas do fluxo = abas da demo (genéricas, sem setor).
const flowAreas = [c.brain.demo.mockLabel, ...c.brain.demo.items.map((item) => item.label)];
const adoption = c.adoption;
// Par "usam IA × usam IA na produção" (FactoryDots): o último ponto da série (mesmo universo da nota) contra o fato
// de produção; os demais fatos viram números com fonte.
const prodFact = adoption?.facts.find((fact) => /produ[cç]|production|shop floor|plant floor/i.test(fact.label) && outOfTen(fact.value) !== null);
const lastPoint = adoption?.series.at(-1);
const dots =
  prodFact && lastPoint && outOfTen(lastPoint.display) !== null
    ? { ai: { value: lastPoint.display, label: `${ui.useAI} (${lastPoint.label})` }, prod: prodFact }
    : null;
const otherFacts = (adoption?.facts ?? []).filter((fact) => fact !== dots?.prod);
const seriesSource = (adoption?.facts.find((fact) => /IBGE|PINTEC/i.test(fact.source.label)) ?? adoption?.facts[0])?.source;
const impact = c.impact;
const impactItems = (impact?.items ?? []).map((item) => ({ ...item, scope: ui.scope[item.scope] }));
const stats = c.proof.stats.map((s) => ({ ...s, source: { label: c.proof.statSource, href: MUNDOLOGISTICA_URL } }));
---

<Base
  locale={locale}
  routeId="home"
  title={copy.meta.home.title}
  description={copy.meta.home.description}
  ogTitle={copy.og.title}
  ogDescription={copy.og.description}
>
  <Header locale={locale} routeId="home" />
  <main id="conteudo" tabindex="-1">
    <!-- 1. Hero: texto + demo do cérebro da operação na 1ª dobra (desktop: lado a lado; celular: demo logo abaixo do CTA) -->
    <Section id={ids.hero} labelledby={`${ids.hero}-title`} class="home-hero" width="wide" reveal={false}>
      <div class="home-hero__stage" data-pointer=".home-hero__field">
        {/* Campo decorativo: grade de pontos e brilho que seguem o ponteiro no desktop (DESIGN §9). */}
        <div class="home-hero__field" aria-hidden="true" data-hero-in="fade"></div>
        <div class="home-hero__copy">
          <SectionHeader as="h1" id={`${ids.hero}-title`} eyebrow={c.hero.eyebrow} title={c.hero.title} lead={c.hero.lead} accent>
            <BookingCta locale={locale} size="lg">{cta}</BookingCta>
            <a class="link link--arrow link--target" href={howWeWork}>{c.hero.secondary}</a>
          </SectionHeader>
          <ul class="home-hero__facts" role="list" data-hero-in>
            {c.hero.facts.map((fact) => <li>{fact}</li>)}
          </ul>
        </div>
        <div class="home-hero__demo" data-hero-in style="--hero-delay: 240ms">
          <AskMock
            locale={locale}
            stage="muted"
            id="cerebro-demo"
            tabsLabel={c.brain.demo.tabsLabel}
            items={[{ label: c.brain.demo.mockLabel, ...c.brain.mock }, ...c.brain.demo.items]}
          />
        </div>
      </div>
    </Section>

    <!-- 2. Cérebro da operação: de onde vêm os dados → cérebro → áreas -->
    <Section id={ids.brain} variant="muted" labelledby={`${ids.brain}-title`}>
      <SectionHeader id={`${ids.brain}-title`} eyebrow={c.brain.eyebrow} title={c.brain.title} lead={c.brain.lead} align="center" accent />
      <SourcesFlow
        id="home-sf"
        class="home-flow"
        inTitle={c.brain.sourcesTitle}
        inputs={c.brain.sources}
        core={ui.core}
        coreNote={ui.coreNote}
        outTitle={ui.outTitle}
        outputs={flowAreas}
      />
      <ul class="grid grid--3 home-points" role="list" data-reveal-stagger>
        {
          c.brain.points.map((point) => (
            <li>
              <h3 class="title">{point.title}</h3>
              <p class="muted">{point.body}</p>
            </li>
          ))
        }
      </ul>
    </Section>

    {
      adoption && (
        <Section id={ui.adoptionId} labelledby={`${ui.adoptionId}-title`}>
          <div class="media-split home-adoption">
            <div class="home-adoption__text">
              <SectionHeader id={`${ui.adoptionId}-title`} eyebrow={adoption.eyebrow} title={adoption.title} lead={adoption.lead} size="md" accent />
            </div>
            <div class="home-adoption__visual">
              {adoption.series.length > 1 && <AdoptionBars locale={locale} series={adoption.series} source={seriesSource} />}
              {dots && <FactoryDots locale={locale} ai={dots.ai.value} aiLabel={dots.ai.label} prod={dots.prod.value} prodLabel={dots.prod.label} source={dots.prod.source} />}
            </div>
          </div>
          {otherFacts.length > 0 && (
            <ul class="grid grid--2 home-facts" role="list" data-reveal-stagger>
              {otherFacts.map((fact) => (
                <li>
                  <p class="home-facts__value tnum">{fact.value}</p>
                  <p class="home-facts__label">{fact.label}</p>
                  <p class="caption home-facts__source">
                    {sourceWord}:{' '}
                    <a class="link" href={fact.source.href} target="_blank" rel="noopener">
                      {fact.source.label}
                    </a>
                  </p>
                </li>
              ))}
            </ul>
          )}
          {adoption.note && <p class="caption home-adoption__note">{adoption.note}</p>}
        </Section>
      )
    }

    <!-- 3. Soluções por área (âncora do header) -->
    <Section id={ids.solutions} variant={adoption ? 'muted' : 'default'} labelledby={`${ids.solutions}-title`}>
      <SectionHeader id={`${ids.solutions}-title`} eyebrow={c.solutions.eyebrow} title={c.solutions.title} lead={c.solutions.lead} accent />
      <p class="home-solutions__label"><Pill tone="accent" size="sm">{c.solutions.exampleLabel}</Pill></p>
      <FeatureGrid columns={4} items={c.solutions.areas} card={adoption ? 'surface' : 'muted'} class="home-areas" carousel illos />
    </Section>

    {
      impact && (
        <Section id={ui.impactId} labelledby={`${ui.impactId}-title`}>
          <SectionHeader id={`${ui.impactId}-title`} eyebrow={impact.eyebrow} title={impact.title} lead={impact.lead} size="md" accent />
          <ImpactCards locale={locale} card="muted" items={impactItems} class="home-impact" />
          {impact.note && <p class="caption home-impact__note">{impact.note}</p>}
        </Section>
      )
    }

    <!-- 4. Software sob medida -->
    <Section id={ids.custom} variant="muted" labelledby={`${ids.custom}-title`}>
      <div class="media-split media-split--reverse">
        <div>
          <SectionHeader id={`${ids.custom}-title`} eyebrow={c.custom.eyebrow} title={c.custom.title} lead={c.custom.lead} accent />
          <ul class="home-checks home-custom__points" role="list">
            {c.custom.points.map((point) => <li>{point}</li>)}
          </ul>
        </div>
        <PanelMock locale={locale} stage="surface" {...c.custom.mock} />
      </div>
    </Section>

    <!-- 5. Como trabalhamos -->
    <Section id={ids.process} labelledby={`${ids.process}-title`}>
      {/* Desktop: cabeçalho fixo + etapa ativa conforme a rolagem (src/scripts/motion.ts, [data-scrolly]). Celular: lista. */}
      <div class="scrolly" data-scrolly>
        <div class="scrolly__aside">
          <SectionHeader id={`${ids.process}-title`} eyebrow={c.process.eyebrow} title={c.process.title} lead={c.process.lead} accent>
            <a class="link link--arrow link--target" href={howWeWork}>{c.process.link}</a>
          </SectionHeader>
          <div class="scrolly__nav" aria-hidden="true">
            <span class="scrolly__rail"><span class="scrolly__bar" data-scrolly-bar></span></span>
            <span class="scrolly__marks">
              {etapas[locale].map((step, index) => (
                <span class="scrolly__mark" data-step-mark>
                  <span class="tnum">{String(index + 1).padStart(2, '0')}</span> {step.title}
                </span>
              ))}
            </span>
          </div>
        </div>
        {/* id legado "precos": artigos do blog (conteúdo intocável) linkam /#precos; as etapas com proposta por etapa substituem a antiga escada de preços. */}
        <div id={locale === 'pt-BR' ? 'precos' : undefined} class="home-steps">
          <Steps items={etapas[locale]} layout="rows" illos />
        </div>
      </div>
    </Section>

    <!-- 6. Estrutura de entrega -->
    <Section id={ids.structure} variant="muted" labelledby={`${ids.structure}-title`}>
      <SectionHeader id={`${ids.structure}-title`} eyebrow={c.structure.eyebrow} title={c.structure.title} lead={c.structure.lead} accent>
        <a class="link link--arrow link--target" href={howWeWork}>{c.structure.link}</a>
      </SectionHeader>
      <FeatureGrid columns={3} card="surface" items={estrutura[locale]} class="home-structure" />
    </Section>

    <!-- 7. Prova -->
    <Section id={ids.proof} variant="inverse" labelledby={`${ids.proof}-title`}>
      <SectionHeader id={`${ids.proof}-title`} eyebrow={c.proof.eyebrow} title={c.proof.title} lead={c.proof.lead} />
      <StatGrid locale={locale} items={stats} columns={2} class="home-stats" />
      <div class="home-cases">
        <CaseCards locale={locale} linkLabel={c.proof.caseLink} card="surface" />
      </div>
      <p class="caption home-proof__note">{c.proof.note}</p>
      <p class="home-proof__all">
        <a class="link link--arrow link--target" href={pathFor('cases', locale)}>{c.proof.allCases}</a>
      </p>
    </Section>

    <!-- 8. Para quem é -->
    <Section id={ids.fit} labelledby={`${ids.fit}-title`}>
      <SectionHeader id={`${ids.fit}-title`} eyebrow={c.fit.eyebrow} title={c.fit.title} size="md" accent />
      <div class="grid grid--2 home-fit">
        <div class="home-fit__col">
          <h3 class="title">{c.fit.yesTitle}</h3>
          <ul class="home-checks" role="list">
            {c.fit.yes.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="home-fit__col home-fit__col--no">
          <h3 class="title">{c.fit.noTitle}</h3>
          <ul class="home-dashes" role="list">
            {c.fit.no.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </Section>

    <!-- 9. FAQ -->
    <Section id={ids.faq} variant="muted" width="narrow" labelledby={`${ids.faq}-title`}>
      <SectionHeader id={`${ids.faq}-title`} eyebrow={c.faq.eyebrow} title={c.faq.title} size="md" accent />
      <Faq items={c.faq.items} name="home-faq" />
    </Section>

    <!-- 10. CTA final -->
    <CtaBand locale={locale} title={c.cta.title} text={c.cta.text} secondary={{ label: c.cta.secondary, href: pathFor('contact', locale) }} />
  </main>
  <Footer locale={locale} routeId="home" />
</Base>

<style>
  /* ---------- Hero: texto + demo (a demo na 1ª dobra em 1440×900; no celular logo abaixo do CTA) ---------- */
  :global(.home-hero.section) {
    overflow: clip;
    padding-block: var(--space-7) var(--space-section-tight);
  }

  .home-hero__stage {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: var(--space-7);
  }

  .home-hero__copy :global(.ds-sh__title) {
    max-inline-size: 18ch;
  }

  .home-hero__copy :global(.ds-sh__lead) {
    max-inline-size: 44ch;
  }

  .home-hero__demo {
    min-inline-size: 0;
  }

  /* Celular: o CTA do hero precisa ficar acima da faixa de consentimento na 1ª visita (CS-f, 360×640). */
  @media (max-width: 30em) {
    :global(.home-hero.section) {
      padding-block-start: var(--space-5);
    }

    .home-hero__copy :global(.ds-sh__title) {
      font-size: 2rem;
    }

    .home-hero__copy :global(.ds-sh__lead) {
      font-size: var(--text-base);
    }
  }

  /* < 1024: a demo vem logo depois do CTA; os fatos do hero descem para baixo dela. */
  @media (max-width: 63.99em) {
    .home-hero__copy {
      display: contents;
    }

    .home-hero__demo {
      order: 1;
    }

    .home-hero__facts {
      order: 2;
      margin-block-start: 0;
    }
  }

  @media (min-width: 64em) {
    .home-hero__stage {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
      gap: var(--space-8);
      min-block-size: min(46rem, calc(100svh - var(--header-height) - var(--space-7) * 2));
    }

    .home-hero__copy :global(.ds-sh__title) {
      font-size: clamp(2.75rem, 1rem + 3.2vw, 4.25rem);
    }

    .home-hero__copy :global(.ds-sh__lead) {
      font-size: var(--text-lead);
    }
  }

  .home-hero__field {
    position: absolute;
    z-index: -1;
    inset-block: calc(-1 * var(--space-section)) calc(-1 * var(--space-7));
    inset-inline: calc(50% - 50vw);
    pointer-events: none;
    --hero-delay: 0ms;
    --at: var(--mx, 30%) var(--my, 38%);
    background:
      radial-gradient(34rem circle at var(--at), color-mix(in srgb, var(--color-accent) 10%, transparent), transparent 70%),
      radial-gradient(circle, var(--color-border) 1px, transparent 1.5px) 0 0 / 22px 22px;
    -webkit-mask-image: radial-gradient(42rem 28rem at var(--at), #000 0%, rgb(0 0 0 / 0.3) 50%, transparent 78%);
    mask-image: radial-gradient(42rem 28rem at var(--at), #000 0%, rgb(0 0 0 / 0.3) 50%, transparent 78%);
  }

  .home-hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-block-start: var(--space-6);
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .home-hero__facts li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .home-hero__facts li::before {
    content: '';
    inline-size: 6px;
    block-size: 6px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
  }

  /* ---------- Cérebro: fluxo de dados ---------- */
  :global(div.home-flow) {
    margin-block-start: var(--space-stack);
  }

  .home-points {
    margin-block-start: var(--space-8);
    padding: 0;
    list-style: none;
    --grid-gap: var(--space-6);
  }

  .home-points p {
    font-size: var(--text-sm);
  }

  .home-points li {
    display: grid;
    gap: var(--space-2);
    padding-block-start: var(--space-5);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  /* ---------- Adoção de IA e resultados medidos ---------- */
  .home-adoption {
    align-items: center;
  }

  .home-adoption__visual {
    display: grid;
    gap: var(--space-4);
    min-inline-size: 0;
  }

  .home-facts {
    --grid-gap: var(--space-5) var(--space-7);
    margin-block-start: var(--space-8);
    padding: 0;
    list-style: none;
  }

  .home-facts li {
    display: grid;
    gap: var(--space-1);
    padding-block-start: var(--space-4);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .home-facts__value {
    font-size: var(--text-title-lg);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-tight);
    line-height: 1.1;
  }

  .home-facts__label {
    font-size: var(--text-sm);
  }

  .home-facts__source,
  .home-adoption__note,
  .home-impact__note {
    color: var(--color-text-muted);
  }

  .home-adoption__note,
  .home-impact__note {
    margin-block-start: var(--space-6);
    max-inline-size: 72ch;
  }

  :global(ul.home-impact) {
    margin-block-start: var(--space-stack);
  }

  .home-solutions__label {
    margin-block-start: var(--space-stack);
  }

  .home-solutions__label + :global(.home-areas) {
    margin-block-start: var(--space-4);
  }

  :global(.home-areas) > :global(li) :global(.ds-card__body),
  :global(.home-structure) > :global(li) :global(.ds-card__body) {
    gap: var(--space-2);
  }

  .home-checks,
  .home-dashes {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: start;
  }

  .home-checks li,
  .home-dashes li {
    position: relative;
    padding-inline-start: 1.75rem;
    text-wrap: pretty;
  }

  .home-checks li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.15rem;
    inset-block-start: 0.35em;
    inline-size: 0.7rem;
    block-size: 0.4rem;
    border-inline-start: 2px solid var(--color-accent-text);
    border-block-end: 2px solid var(--color-accent-text);
    transform: rotate(-45deg);
  }

  .home-dashes li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.1rem;
    inset-block-start: 0.75em;
    inline-size: 0.8rem;
    block-size: 2px;
    background: var(--color-text-muted);
  }

  .home-custom__points {
    margin-block-start: var(--space-6);
  }

  .home-stats {
    margin-block-start: var(--space-stack);
  }

  .home-cases {
    margin-block-start: var(--space-8);
  }

  .home-proof__note {
    margin-block-start: var(--space-6);
    max-inline-size: 72ch;
    color: var(--color-text-muted);
  }

  .home-proof__all {
    margin-block-start: var(--space-4);
  }

  /* ---------- Etapas: rolagem fixa no desktop (estilo produto) ---------- */
  .scrolly__nav {
    display: none;
  }

  .home-steps {
    margin-block-start: var(--space-stack);
  }

  @media (min-width: 64em) {
    .scrolly {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-8);
      align-items: start;
    }

    .scrolly__aside {
      position: sticky;
      top: calc(var(--header-height) + var(--space-8));
    }

    .home-steps {
      margin-block-start: 0;
    }

    .scrolly__nav {
      display: grid;
      grid-template-columns: 2px minmax(0, 1fr);
      gap: var(--space-5);
      margin-block-start: var(--space-7);
    }

    .scrolly__rail {
      position: relative;
      border-radius: 2px;
      background: var(--color-border);
      overflow: hidden;
    }

    .scrolly__bar {
      position: absolute;
      inset: 0;
      background: var(--color-accent);
      transform: scaleY(0);
      transform-origin: 50% 0;
    }

    .scrolly__marks {
      display: grid;
      gap: var(--space-3);
      font-size: var(--text-sm);
      color: var(--color-text-muted);
    }

    .scrolly__mark {
      transition: color var(--motion-short) var(--motion-ease-in-out), transform var(--motion-short) var(--motion-ease-out);
    }

    .scrolly__mark .tnum {
      margin-inline-end: var(--space-2);
    }

    .scrolly__mark.is-active {
      color: var(--color-text);
      font-weight: var(--weight-medium);
      transform: translateX(4px);
    }

    /* Com motion: cada etapa ocupa meia tela e a ativa ganha destaque. Inativas seguem legíveis (AA). */
    :global(html.motion-ready) .home-steps :global(.ds-steps__item) {
      min-block-size: 44vh;
      align-content: center;
      border-block-start-color: var(--color-border-subtle);
      transition: border-color var(--motion-short) var(--motion-ease-in-out);
    }

    :global(html.motion-ready) .home-steps :global(.ds-steps__item:last-child) {
      min-block-size: 36vh;
    }

    .home-steps :global(.ds-steps__num) {
      font-size: var(--text-display-md);
      font-weight: var(--weight-display);
      line-height: 1;
      transition: color var(--motion-short) var(--motion-ease-in-out), transform var(--motion-reveal) var(--motion-ease);
    }

    .home-steps :global(.ds-steps__item) {
      grid-template-columns: 6rem minmax(0, 1fr);
    }

