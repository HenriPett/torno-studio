---
/**
 * Páginas mantidas fora da navegação (/recuperacao-de-projeto/, /lovable-em-producao/ + EN), linkadas pelo blog.
 * Estratégia 2026-11 §6: design novo, marca "Torno", sem exibição de preço. Copy em content/seo/commercial.ts.
 */
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PageAnswer from './PageAnswer.astro';
import BookingCta from '../ui/BookingCta.astro';
import Section from '../ds/Section.astro';
import SectionHeader from '../ds/SectionHeader.astro';
import Card from '../ds/Card.astro';
import Faq from '../ds/Faq.astro';
import CtaBand from '../ds/CtaBand.astro';
import { commercial, type CommercialRoute } from '../../content/seo/commercial';
import { pathFor, type Locale } from '../../lib/i18n';
interface Props { locale: Locale; routeId: CommercialRoute }
const { locale, routeId } = Astro.props;
const c = commercial[locale][routeId];
const en = locale === 'en';
const lovable = routeId === 'lovableProduction';
const text = (pt: string, english: string) => en ? english : pt;
const limit = text('Conversa sobre contexto, impacto e encaixe. Auditoria técnica e pentest ficam fora dela.', 'A conversation about context, impact and fit. A technical audit or penetration test is outside its scope.');
const other = lovable
  ? { label: text('Um sistema interno travou no meio do caminho?', 'Is an internal system stuck halfway?'), href: pathFor('recovery', locale) }
  : { label: text('Seu ponto de partida é um app Lovable?', 'Starting from a Lovable app?'), href: pathFor('lovableProduction', locale) };
---
<Base locale={locale} routeId={routeId} title={c.title} description={c.description}>
  <Header locale={locale} routeId={routeId} />
  <main id="conteudo" tabindex="-1">
    <Section labelledby="page-title" reveal={false} class="cp-hero">
      <SectionHeader as="h1" id="page-title" size="lg" eyebrow={c.eyebrow} accent title={c.heading} lead={c.intro}>
        <BookingCta locale={locale}>{text('Agendar diagnóstico', 'Book a call')}</BookingCta>
        <a class="link link--arrow link--target" href="#escopo">{text('Ver o escopo', 'See the scope')}</a>
      </SectionHeader>
      <div class="cp-hero__notes">
        <p class="caption">{limit}</p>
        <p class="cp-hero__who">{text('Henrique Pett, fundador e líder técnico da Torno, conduz a avaliação e a implementação. Você fala direto com quem define e implementa a entrega.', 'Henrique Pett, founder and technical lead of Torno, runs the assessment and the implementation. You work directly with the person who scopes and implements the delivery.')} <a class="link" href={pathFor('author', locale)}>{text('Conheça a trajetória', 'Read his background')}</a>.</p>
        <PageAnswer locale={locale} routeId={routeId} />
      </div>
    </Section>

    <Section variant="muted" labelledby="context-title">
      <div class="cp-split">
        <div class="cp-split__text">
          <h2 id="context-title" class="display-md">{c.contextTitle}</h2>
          <p class="cp-body">{c.context}</p>
        </div>
        <Card variant="surface" padding="lg" radius="xl" class="cp-split__card">
          <h3 class="title">{text('O que precisamos entender', 'What we need to understand')}</h3>
          <ul class="cp-checks" role="list">{c.inventory.map(item => <li>{item}</li>)}</ul>
        </Card>
      </div>
    </Section>

    <Section labelledby="decision-title">
      <SectionHeader id="decision-title" size="md" title={text('Reparar ou reconstruir?', 'Repair or rebuild?')} />
      <ul class="cp-grid cp-grid--2" role="list">
        <Card as="li" padding="lg" radius="xl"><h3 class="title">{text('Preservar e corrigir', 'Retain and repair')}</h3><p class="cp-muted">{c.repair}</p></Card>
        <Card as="li" padding="lg" radius="xl"><h3 class="title">{text('Replanejar antes de executar', 'Rescope before execution')}</h3><p class="cp-muted">{c.rebuild}</p></Card>
      </ul>
    </Section>

    <Section variant="muted" labelledby="delivery-title">
      <SectionHeader id="delivery-title" size="md" title={text('O que torna a entrega verificável', 'What makes delivery verifiable')} lead={text('Esta é a estrutura de aceite que adaptamos a cada projeto.', 'This is the acceptance structure we adapt to each project.')} />
      <dl class="cp-grid cp-grid--3 cp-deliverables">{c.delivery.map(([title, body]) => <div class="cp-deliverable"><dt class="title">{title}</dt><dd class="cp-muted">{body}</dd></div>)}</dl>
      <p class="cp-after"><a class="link link--arrow link--target" href={pathFor('rlsGuide', locale)}>{text('Ver guia de permissões entre empresas', 'Read the multi-tenant permissions guide')}</a></p>
    </Section>

    {lovable && <Section labelledby="native-title" width="narrow">
      <h2 id="native-title" class="display-md">{text('Começar pelos recursos que já existem', 'Start with the tools already available')}</h2>
      <div class="cp-prose">
        <p>{text('O Quick scan verifica regras de banco, dependências e exposição de MCP. O Deep scan inclui lógica, permissões, dados e pagamentos. Aproveitamos os achados e as correções elegíveis; a matriz de aceite documenta os cenários específicos da sua operação.', 'Quick scan checks database rules, dependencies and MCP exposure. Deep scan also reviews logic, permissions, data and payments. We use existing findings and eligible fixes; acceptance criteria document your specific business scenarios.')}</p>
        <p>{text('Pagamentos nativos e integrações próprias entram no inventário separadamente. Confirmamos o caminho usado pelo app antes de delimitar testes e mudanças.', 'Native payments and custom integrations are inventoried separately. We confirm the path the app uses before scoping tests and changes.')}</p>
        <p class="caption">{text('Referências oficiais consultadas em 13/10/2026:', 'Official references reviewed October 13, 2026:')} <a class="link" href="https://docs.lovable.dev/features/security">Lovable Security</a> · <a class="link" href="https://docs.lovable.dev/features/payments">Payments</a> · <a class="link" href="https://docs.lovable.dev/introduction/support-policy">Support policy</a>.</p>
      </div>
    </Section>}

    <Section id="escopo" variant={lovable ? 'muted' : 'default'} labelledby="scope-title">
      <div class="cp-split">
        <div class="cp-split__text">
          <h2 id="scope-title" class="display-md">{text('Escopo combinado antes de começar', 'Scope agreed before work starts')}</h2>
          <p class="cp-body">{c.fit}</p>
          <p class="cp-body cp-muted">{text('A proposta é fechada depois da conversa inicial e da avaliação do sistema, com entregas e critérios de aceite por etapa.', 'The proposal is fixed after the first call and an assessment of the system, with deliverables and acceptance criteria for each stage.')}</p>
        </div>
        <Card variant={lovable ? 'surface' : 'muted'} padding="lg" radius="xl" class="cp-split__card">
          <h3 class="title">{text('O que fica fora', 'What is excluded')}</h3>
          <ul class="cp-checks cp-checks--out" role="list">{c.exclusions.map(item => <li>{item}</li>)}</ul>
        </Card>
      </div>
    </Section>

    <Section id="contato" variant={lovable ? 'default' : 'muted'} labelledby="faq-title" width="narrow">
      <h2 id="faq-title" class="display-md">{text('Antes de conversar', 'Before we talk')}</h2>
      <p class="cp-body cp-intro">{text('Na conversa, traga o fluxo travado, impacto, usuários ou piloto, prazo, quem decide e a faixa de orçamento. Confirme se pode autorizar acesso ao código. Não envie senhas, chaves ou dados de clientes; eventuais acessos serão combinados por convite e permissões adequadas.', 'Bring the blocked workflow, business impact, users or pilot, deadline, decision-maker and budget range. Confirm whether you can authorize source access. Do not send passwords, keys or customer data; any access will be arranged through invitations and appropriate permissions.')}</p>
      <Faq class="cp-faq" items={c.faq.map(([q, a]) => ({ q, a }))} />
    </Section>

    <CtaBand locale={locale} id="agendar-conversa" title={text('Vamos delimitar o próximo passo.', 'Let’s define the next step.')} text={limit} secondary={other} />
  </main>
  <Footer locale={locale} routeId={routeId} />
</Base>
<style>
  .cp-hero__notes { display: grid; gap: var(--space-4); margin-block-start: var(--space-7); max-inline-size: var(--measure); }
  .cp-hero__who { text-wrap: pretty; }
  .cp-body { margin-block-start: var(--space-4); max-inline-size: var(--measure); text-wrap: pretty; }
  .cp-muted { color: var(--color-text-muted); }
  .cp-split { display: grid; gap: var(--space-6); }
  .cp-split__card > :global(.ds-card__body > * + *) { margin-block-start: var(--space-4); }
  .cp-checks { padding: 0; list-style: none; }
  .cp-checks li { position: relative; padding-block: var(--space-3); padding-inline-start: var(--space-5); border-block-start: var(--border-width) solid var(--color-border-subtle); }
  .cp-checks li::before { content: ""; position: absolute; inset-inline-start: 0; inset-block-start: calc(var(--space-3) + 0.6em); inline-size: 0.5rem; block-size: 0.5rem; border-radius: var(--radius-full); background: var(--color-accent); }
  .cp-checks--out li::before { background: var(--color-border-strong); }
  .cp-grid { display: grid; gap: var(--space-gutter); padding: 0; list-style: none; margin-inline: 0; margin-block-end: 0; }
  .cp-grid > :global(li > .ds-card__body > * + *) { margin-block-start: var(--space-3); }
  .cp-deliverable { padding-block-start: var(--space-4); border-block-start: 2px solid var(--color-text); }
  .cp-deliverable dd { margin: var(--space-3) 0 0; }
  .cp-after { margin-block-start: var(--space-6); }
  .cp-prose { margin-block-start: var(--space-5); }
  .cp-prose > * + * { margin-block-start: var(--space-4); }
  .cp-intro { margin-block-end: var(--space-6); }
  @media (min-width: 48em) {
    .cp-grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cp-grid--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--space-7); }
  }
  @media (min-width: 64em) {
    .cp-split { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); column-gap: var(--space-8); align-items: start; }
    .cp-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
