---
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PageAnswer from '../seo/PageAnswer.astro';
import CtaBand from '../ds/CtaBand.astro';
import type { Locale } from '../../lib/i18n';
import { guideCopy } from './content';
import schema from '../../../public/examples/rls-multiempresa/schema.sql?raw';
interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = guideCopy[locale];
const files = ['run-local.sh', 'bootstrap-local.sql', 'schema.sql', 'tests.sql'];
const sources = [
  ['Supabase — Row Level Security', 'https://supabase.com/docs/guides/database/postgres/row-level-security'],
  ['PostgreSQL — Row Security Policies', 'https://www.postgresql.org/docs/current/ddl-rowsecurity.html'],
  ['Lovable — Security overview', 'https://docs.lovable.dev/features/security'],
  ['Supabase — Identifying Lovable Cloud or Supabase', 'https://supabase.com/docs/guides/troubleshooting/identify-lovable-cloud-or-supabase-backend'],
  ['PGlite — PostgreSQL WASM', 'https://pglite.dev/docs/'],
];
---
<Base locale={locale} routeId="rlsGuide" title={copy.title} description={copy.description}>
  <Header locale={locale} routeId="rlsGuide" />
  <main id="conteudo" tabindex="-1" class="guide-main">
    <article class="container guide">
      <header class="guide__heading">
        <p class="eyebrow eyebrow--accent">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
        <p class="lead intro">{copy.intro}</p>
        <PageAnswer locale={locale} routeId="rlsGuide" />
      </header>
      <nav aria-label={copy.toc} class="contents">
        <p class="eyebrow">{copy.toc}</p>
        <ol>{copy.sections.map(section => <li><a class="link link--quiet" href={`#${section.id}`}>{section.title.replace(/^\d\. /, '')}</a></li>)}</ol>
      </nav>
      {copy.sections.map(section => (
        <section id={section.id} aria-labelledby={`${section.id}-title`}>
          <h2 id={`${section.id}-title`}>{section.title}</h2>
          {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
          {section.id === 'matriz' && (
            <div class="table-scroll" tabindex="0" role="region" aria-label={copy.matrixCaption}>
              <table>
                <caption>{copy.matrixCaption}</caption>
                <thead><tr>{copy.headers.map(label => <th scope="col">{label}</th>)}</tr></thead>
                <tbody>{copy.rows.map(row => <tr><th scope="row">{row[0]}</th><td>{row[1]}</td><td>{row[2]}</td></tr>)}</tbody>
              </table>
            </div>
          )}
          {section.id === 'executar' && (
            <>
              <h3>{copy.download}</h3>
              <ul class="files" role="list">{files.map(file => <li><a class="link link--target" href={`/examples/rls-multiempresa/${file}`} download><code>{file}</code></a></li>)}</ul>
              <pre tabindex="0" aria-label={locale === 'en' ? 'Run command' : 'Comando de execução'}><code>bash run-local.sh</code></pre>
              <p>{locale === 'en' ? 'PostgreSQL WASM alternative: ' : 'Alternativa PostgreSQL WASM: '}<a class="link" href="/examples/rls-multiempresa/run-wasm.mjs" download>run-wasm.mjs</a></p>
              <p><a class="link" href="/examples/rls-multiempresa/README.txt">{locale === 'en' ? 'Instructions and WASM alternative (PT/EN)' : 'Instruções e alternativa WASM (PT/EN)'}</a></p>
              <details><summary>{copy.sql}</summary><pre tabindex="0" aria-label="SQL"><code>{schema}</code></pre></details>
            </>
          )}
        </section>
      ))}
      <section aria-labelledby="sources-title" class="sources"><h2 id="sources-title">{copy.sources}</h2>
        <ul>{sources.map(([label, url]) => <li><a class="link" href={url}>{label}</a></li>)}</ul>
      </section>
      <section aria-labelledby="related-title" class="related"><h2 id="related-title" class="eyebrow">{locale === 'en' ? 'Related pages' : 'Páginas relacionadas'}</h2>
        <ul role="list"><li><a class="link link--arrow link--target" href={copy.rescuePath}>{copy.rescue}</a></li><li><a class="link link--arrow link--target" href={copy.productionPath}>{copy.production}</a></li></ul>
      </section>
    </article>
    <CtaBand locale={locale} id="guia-contato" title={copy.ctaTitle} text={copy.cta} cta={copy.book}>
      <p>{copy.bookingNote}</p>
      <p>{copy.origin}</p>
    </CtaBand>
  </main>
  <Footer locale={locale} routeId="rlsGuide" />
</Base>
<style>
  .guide-main { padding-block-start: var(--space-6); }
  .guide { max-inline-size: calc(68ch + 2 * var(--container-pad)); padding-block-end: var(--space-section-tight); line-height: 1.65; }
  .guide__heading { margin-block-end: var(--space-7); }
  h1 { margin-block: var(--space-3) var(--space-5); font-size: var(--text-display-md); font-weight: var(--weight-display); line-height: var(--leading-tight); letter-spacing: var(--tracking-tight); text-wrap: balance; }
  .intro { max-inline-size: none; }
  h2 { font-size: var(--text-title-lg); font-weight: var(--weight-display); line-height: var(--leading-tight); letter-spacing: var(--tracking-title); text-wrap: balance; }
  h3 { font-size: var(--text-title); font-weight: var(--weight-semibold); letter-spacing: var(--tracking-title); margin-block-start: var(--space-6); }
  p, ul, ol { margin-block-start: var(--space-4); }
  li + li { margin-block-start: var(--space-2); }
  ul, ol { padding-inline-start: 1.25em; }
  .contents { padding: var(--space-5); background: var(--color-surface-muted); border-radius: var(--radius-lg); }
  .contents ol { list-style: none; padding: 0; margin-block-start: var(--space-3); counter-reset: toc; }
  .contents li { counter-increment: toc; display: grid; grid-template-columns: 2ch minmax(0, 1fr); gap: var(--space-3); margin: 0; padding-block: var(--space-2); border-block-start: var(--border-width) solid var(--color-border); }
  .contents li::before { content: counter(toc); color: var(--color-text-muted); }
  section { margin-block-start: var(--space-8); scroll-margin-block-start: calc(var(--header-height) + var(--space-4)); }
  section > h2 + p { margin-block-start: var(--space-4); }
  a { overflow-wrap: anywhere; }
  code { font-family: var(--font-mono); font-size: 0.9em; }
  .files { padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
  .files li { margin: 0; }
  .table-scroll { overflow-x: auto; margin-block-start: var(--space-5); border: var(--border-width) solid var(--color-border); border-radius: var(--radius-lg); }
  .table-scroll:focus-visible, pre:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-offset); }
  table { inline-size: 100%; border-collapse: collapse; font-size: var(--text-sm); line-height: 1.5; }
  caption { text-align: start; padding: var(--space-3) var(--space-4); font-size: var(--text-caption); color: var(--color-text-muted); }
  th, td { text-align: start; padding: var(--space-3) var(--space-4); border-block-start: var(--border-width) solid var(--color-border-subtle); }
  thead th { background: var(--color-surface-muted); font-weight: var(--weight-semibold); }
  tbody th { font-weight: var(--weight-medium); }
  pre { max-inline-size: 100%; overflow-x: auto; padding: var(--space-4) var(--space-5); margin-block-start: var(--space-4); background: var(--color-surface-muted); font-size: var(--text-sm); line-height: 1.6; border: var(--border-width) solid var(--color-border-subtle); border-radius: var(--radius-md); }
  details { margin-block-start: var(--space-5); border-block: var(--border-width) solid var(--color-border); }
  summary { cursor: pointer; display: flex; align-items: center; min-block-size: var(--tap-min); padding-block: var(--space-3); font-weight: var(--weight-semibold); }
  details[open] pre { margin-block-end: var(--space-4); }
  .sources ul { font-size: var(--text-sm); }
  .related { padding-block-start: var(--space-5); border-block-start: var(--border-width) solid var(--color-border); }
  .related ul { padding: 0; list-style: none; display: flex; flex-wrap: wrap; column-gap: var(--space-6); margin-block-start: var(--space-2); }
  .related li { margin: 0; }
  @media (min-width: 64em) { .guide-main { padding-block-start: var(--space-7); } .contents { padding: var(--space-6); } }
</style>
