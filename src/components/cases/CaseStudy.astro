---
/**
 * Página de case (estratégia 2026-11 §6, DESIGN-2026-11 §8): hero com categoria, título e lead e a
 * ficha lateral (papel, escopo, evidência) → captura real → contexto → o que foi feito → do dado à
 * decisão → resultados com fonte → o que isso significa para uma indústria → fontes → outros cases → CTA.
 * Ritmo de fundos: default → muted → default → muted → default → inverse → default → muted → inverse.
 */
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PageAnswer from '../seo/PageAnswer.astro';
import Section from '../ds/Section.astro';
import SectionHeader from '../ds/SectionHeader.astro';
import FeatureGrid from '../ds/FeatureGrid.astro';
import Steps from '../ds/Steps.astro';
import StatGrid from '../ds/StatGrid.astro';
import MediaFrame from '../ds/MediaFrame.astro';
import CtaBand from '../ds/CtaBand.astro';
import ResultChart from './ResultChart.astro';
import CaseCard from './CaseCard.astro';
import { caseLabels, caseSlugs, caseStudies, type CaseSlug } from '../../content/cases';
import { pathFor, type Locale } from '../../lib/i18n';
import looptShot from '../../assets/cases/loopt-public-site.webp';
import ascendeShot from '../../assets/cases/ascende-public-site.webp';

interface Props {
  locale: Locale;
  slug: CaseSlug;
}

const { locale, slug } = Astro.props;
const c = caseStudies[locale][slug];
const l = caseLabels[locale];
const answerRoute = { loopt: 'caseLoopt', ascende: 'caseAscende', 'bom-capital': 'caseBomCapital' } as const;
const shots = { loopt: looptShot, ascende: ascendeShot };
const related = caseSlugs.filter((key) => key !== slug);
const facts: [string, string][] = [
  [l.role, c.facts.role],
  [l.scope, c.facts.scope],
  [l.evidence, c.facts.evidence],
];
---

<Base
  locale={locale}
  routeId={c.routeId}
  title={`Case ${c.name} | {brand}`}
  description={c.description}
  ogTitle={c.title}
  ogImagePath={`/og/cases/${slug}-${locale}.png`}
  ogImageAlt={c.title}
>
  <Header locale={locale} routeId={c.routeId} />
  <main id="conteudo" tabindex="-1" class="case-study">
    <Section labelledby="case-title" class="case-hero">
      <a class="link link--quiet link--target case-back" href={pathFor('cases', locale)}><span aria-hidden="true">‹ </span>{l.back}</a>
      <div class="case-hero__grid">
        <div class="case-hero__main">
          <SectionHeader as="h1" size="lg" id="case-title" eyebrow={c.category} accent title={c.title} lead={c.lead} />
          <PageAnswer locale={locale} routeId={answerRoute[slug]} />
        </div>
        <aside class="case-facts" aria-labelledby="case-facts-title">
          <h2 id="case-facts-title" class="eyebrow">{l.facts}</h2>
          <dl>
            {
              facts.map(([label, value]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))
            }
          </dl>
          <p class="caption case-facts__note">{c.footnote}</p>
        </aside>
      </div>
    </Section>

    {
      c.screenshot && (
        <Section width="wide" flushTop>
          <MediaFrame chrome="window" label={l.screenshotLabel} caption={c.screenshot.caption} class="case-shot">
            <Image
              src={shots[c.screenshot.image]}
              alt={c.screenshot.alt}
              widths={[640, 960, 1600]}
              sizes="(max-width: 48em) 94vw, 1200px"
              format="webp"
              loading="lazy"
            />
          </MediaFrame>
        </Section>
      )
    }

    <Section variant="muted" labelledby="case-context">
      <div class="case-split">
        <SectionHeader id="case-context" eyebrow={l.context} title={c.context.title} size="md" />
        <div class="case-prose">{c.context.paragraphs.map((p) => <p>{p}</p>)}</div>
      </div>
    </Section>

    <Section labelledby="case-work">
      <SectionHeader id="case-work" eyebrow={l.work} title={c.work.title} size="md" />
      <FeatureGrid columns={3} items={c.work.items} class="case-gap" />
    </Section>

    <Section variant="muted" labelledby="case-flow">
      <SectionHeader id="case-flow" eyebrow={l.flow} title={c.flow.title} size="md" />
      {
        c.flow.example && (
          <figure class="case-example">
            <figcaption class="caption">{c.flow.example.label}</figcaption>
            <blockquote>
              <p>{c.flow.example.text}</p>
            </blockquote>
          </figure>
        )
      }
      <Steps items={c.flow.steps} class="case-gap" />
      <p class="caption case-note">{c.flow.note}</p>
    </Section>

    <Section id="resultados" labelledby="case-results">
      <div class="case-split">
        <div>
          <SectionHeader id="case-results" eyebrow={l.results} title={c.results.title} size="md" lead={c.results.lead} />
        </div>
        <div class="case-results">
          {c.results.stats && <StatGrid locale={locale} columns={2} items={c.results.stats} />}
          {c.results.chart && <ResultChart kind={c.results.chart} locale={locale} />}
          {
            c.results.product && (
              <div class="case-product">
                <h3 class="title">{c.results.product.title}</h3>
                <ul>
                  {c.results.product.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                <a class="link link--arrow link--target" href={c.results.product.link.href} target="_blank" rel="noopener">
                  {c.results.product.link.label}
                </a>
              </div>
            )
          }
          <p class="caption case-note">{c.results.note}</p>
        </div>
      </div>
    </Section>

    <Section variant="inverse" labelledby="case-meaning">
      <SectionHeader id="case-meaning" eyebrow={l.meaning} title={c.meaning.title} lead={c.meaning.lead} />
      <FeatureGrid columns={c.meaning.items.length === 4 ? 2 : 3} items={c.meaning.items} card="surface" class="case-gap" />
      {c.meaning.note && <p class="caption case-note">{c.meaning.note}</p>}
    </Section>

    <Section id="fontes" width="narrow" labelledby="case-sources">
      <SectionHeader id="case-sources" eyebrow={l.sources} title={l.sourcesTitle} size="md" />
      <div class="case-prose case-sources">
        <p>{c.sourceNote}</p>
        {
          c.sources.length > 0 && (
            <ul role="list">
              {c.sources.map((source) => (
                <li>
                  <a class="link link--arrow link--target" href={source.href} target="_blank" rel="noopener">
                    {source.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        <p class="case-footnote">{c.footnote}</p>
        <p class="caption">{l.reviewed}</p>
      </div>
    </Section>

    <Section variant="muted" tight labelledby="case-related">
      <SectionHeader id="case-related" title={l.others} size="md" />
      <div class="grid grid--2 case-gap carousel-sm" data-reveal-stagger>
        {related.map((key) => <CaseCard locale={locale} slug={key} variant="surface" />)}
      </div>
      <p class="case-all"><a class="link link--arrow link--target" href={pathFor('cases', locale)}>{l.allCases}</a></p>
    </Section>

    <CtaBand locale={locale} title={c.cta.title} text={c.cta.text} />
  </main>
  <Footer locale={locale} routeId={c.routeId} />
</Base>

<style>
  .case-back {
    display: inline-flex;
    align-items: center;
    margin-block-end: var(--space-6);
    font-size: var(--text-sm);
  }
  .case-hero__grid {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }
  .case-hero__main {
    min-inline-size: 0;
  }
  .case-facts {
    padding: var(--space-6);
    background: var(--color-surface-muted);
    border-radius: var(--radius-xl);
  }
  .case-facts h2 {
    margin: 0 0 var(--space-4);
  }
  .case-facts dl {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }
  .case-facts dl > div + div {
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
  }
  .case-facts dt {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .case-facts dd {
    margin: var(--space-1) 0 0;
    font-weight: var(--weight-medium);
  }
  .case-facts__note {
    margin-block-start: var(--space-5);
  }
  .case-split {
    display: grid;
    gap: var(--space-6);
  }
  .case-prose {
    display: grid;
    gap: var(--space-4);
    max-inline-size: 65ch;
  }
  :global(.case-gap) {
    margin-block-start: var(--space-7);
  }
  .case-note {
    margin-block-start: var(--space-5);
    max-inline-size: 75ch;
  }
  .case-example {
    margin: var(--space-6) 0 0;
    padding: var(--space-5) var(--space-6);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    max-inline-size: 46rem;
  }
  .case-example blockquote {
    margin: var(--space-2) 0 0;
    font-size: var(--text-lead);
    line-height: var(--leading-snug);
  }
  .case-results {
    display: grid;
    gap: var(--space-2);
    min-inline-size: 0;
  }
  .case-product {
    padding: var(--space-6);
    background: var(--color-surface-muted);
    border-radius: var(--radius-lg);
  }
  .case-product ul {
    margin: var(--space-4) 0;
    padding-inline-start: 1.2rem;
    display: grid;
    gap: var(--space-2);
  }
  .case-sources ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .case-footnote {
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
    font-weight: var(--weight-medium);
  }
  .case-all {
    margin-block-start: var(--space-5);
  }
  :global(.case-shot img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
  @media (min-width: 1024px) {
    .case-hero__grid {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      gap: var(--space-9);
    }
    .case-split {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--space-8);
    }
  }
</style>
