---
/**
 * Gráfico do relato da Bom.Capital (números autodeclarados): barras horizontais com escala de 0 a 48 h.
 * O "depois" é um limite superior (< 2 h): barra tracejada, sem duração exata. Sem selo de resultado
 * publicado; o rótulo diz que é relato. Números com fonte pública (Loopt) usam ds/StatGrid.
 */
import type { Locale } from '../../lib/i18n';
import { caseLabels } from '../../content/cases';

interface Props {
  kind: 'bom-capital';
  locale: Locale;
}

const { locale } = Astro.props;
const en = locale === 'en';
const text = (pt: string, english: string) => (en ? english : pt);
const max = 48;
const rows = [
  { label: text('Antes · média', 'Before · average'), value: 48, display: '48 h', bound: false },
  { label: text('Depois · relatado', 'After · reported'), value: 2, display: '< 2 h', bound: true },
];
---

<figure class="result-chart">
  <figcaption>
    <span class="eyebrow">{caseLabels[locale].chartLabel}</span>
    <span class="result-chart__title">{text('Tempo entre proposta e resposta, em horas', 'Time from application to response, in hours')}</span>
  </figcaption>
  <dl>
    {
      rows.map((row) => (
        <div class="chart-row">
          <dt>{row.label}</dt>
          <dd>
            <div class="chart-track" aria-hidden="true">
              <span class:list={['chart-bar', row.bound && 'chart-bar--bound']} style={`inline-size:${(row.value / max) * 100}%`} />
            </div>
            <span class="chart-value tnum">{row.display}</span>
          </dd>
        </div>
      ))
    }
  </dl>
  <div class="chart-axis tnum" aria-hidden="true">{[0, 12, 24, 36, 48].map((tick) => <span>{tick}</span>)}</div>
  <p class="caption">
    {
      text(
        'A barra tracejada marca o limite de 2 h. O valor relatado está abaixo dele; não há uma duração exata disponível.',
        'The dashed bar marks the 2 h bound. The reported value is below it; no exact duration is available.',
      )
    }
  </p>
</figure>

<style>
  .result-chart {
    margin: 0;
    padding: var(--space-6);
    background: var(--color-surface-muted);
    border-radius: var(--radius-lg);
  }
  figcaption {
    display: grid;
    gap: var(--space-2);
  }
  .result-chart__title {
    font-size: var(--text-title);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-title);
    line-height: var(--leading-snug);
  }
  dl {
    margin-block-start: var(--space-6);
  }
  .chart-row + .chart-row {
    margin-block-start: var(--space-5);
  }
  dt {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-block-end: var(--space-2);
  }
  dd {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.5rem;
    gap: var(--space-3);
    align-items: center;
    margin: 0;
  }
  .chart-track {
    block-size: 28px;
    background: var(--color-bg);
    border-radius: var(--radius-xs);
    overflow: hidden;
  }
  .chart-bar {
    display: block;
    block-size: 100%;
    background: var(--color-text-muted);
  }
  .chart-bar--bound {
    background: transparent;
    border: 2px dashed var(--color-accent-text);
    border-radius: var(--radius-xs);
    min-inline-size: 8px;
  }
  .chart-value {
    font-weight: var(--weight-semibold);
  }
  .chart-axis {
    display: flex;
    justify-content: space-between;
    margin-block-start: var(--space-3);
    margin-inline-end: calc(4.5rem + var(--space-3));
    padding-block-start: var(--space-2);
    border-block-start: 1px solid var(--color-border-strong);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .caption {
    margin-block-start: var(--space-5);
  }
</style>
