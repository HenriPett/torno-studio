---
/**
 * Hero (`#inicio`, DESIGN §7.1): eyebrow → manchete → subtítulo → CTAs → microprova → painel de fatos.
 * O painel reaproveita nomes dos degraus (copy) e preços de pricing.ts; nenhum texto novo.
 */
import { site } from '../../config/site';
import { pricing, type StepId } from '../../config/pricing';
import { getCopy, type Locale } from '../../lib/i18n';
import BookingCta from '../ui/BookingCta.astro';
import Price from '../ui/Price.astro';

interface Props {
  locale: Locale;
  /**
   * Landing de campanha (DESIGN §14.3): texto e microprova próprios, sem CTA secundário, painel de fatos só
   * a partir de 1024 px e respiro menor no topo, para o CTA ficar acima do banner de consentimento.
   */
  campaign?: { eyebrow?: string | undefined; title: string; subtitle: string; cta: string; proofLine: string[] };
}

const { locale, campaign } = Astro.props;
const copy = getCopy(locale);
const { ladder } = copy;
const hero = campaign
  ? { eyebrow: campaign.eyebrow, headline: campaign.title, subheadline: campaign.subtitle, primaryCta: campaign.cta }
  : copy.hero;
const secondaryCta = campaign ? null : copy.hero.secondaryCta;
const proofLine = campaign ? campaign.proofLine : copy.hero.proofLine;

const FACT_STEPS: StepId[] = ['diagnostic', 'sprint', 'mvpCore'];
const facts = FACT_STEPS.map((id) => {
  const step = pricing[locale].steps.find((s) => s.id === id);
  if (!step) throw new Error(`pricing.ts sem o degrau ${id}`);
  return { id, label: ladder.steps[id].name, price: step.price };
});
---

<section id="inicio" class:list={['hero', campaign && 'hero--campaign']} aria-labelledby="inicio-title">
  <div class="container hero__grid">
    <div class="hero__text">
      {hero.eyebrow && <p class="eyebrow">{hero.eyebrow}</p>}
      <h1 id="inicio-title" class="hero__title">{hero.headline}</h1>
      <p class="lead hero__sub">{hero.subheadline}</p>
      <div class="actions hero__actions">
        <BookingCta locale={locale} arrow>{hero.primaryCta}</BookingCta>
        {
          secondaryCta && (
            <a class="btn btn--secondary btn--lg" href="#precos">
              {secondaryCta}
            </a>
          )
        }
      </div>
      {
        proofLine.length > 0 && (
          <ul class="hero__proof meta">
            {proofLine.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )
      }
      {!campaign && site.contactEmail && (
        <p class="hero__email">{copy.hero.emailLead} <a class="link link--target" href={`mailto:${site.contactEmail}`}>{copy.hero.emailCta}</a></p>
      )}
    </div>
    <dl class="hero__facts">
      {
        facts.map((fact) => (
          <div class="hero__fact" data-step={fact.id}>
            <dt>{fact.label}</dt>
            <dd>
              <Price price={fact.price} locale={locale} />
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-7) var(--space-8);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-6);
  }

  /* Landing: menos respiro no topo e painel de fatos só no desktop (DESIGN §14.3). */
  @media (max-width: 39.99em) {
    .hero--campaign {
      padding-block-start: var(--space-5);
    }
  }

  @media (max-width: 63.99em) {
    .hero--campaign .hero__facts {
      display: none;
    }
  }

  .hero__title {
    margin-block-start: var(--space-3);
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    max-inline-size: var(--measure-headline);
    text-wrap: balance;
  }

  .hero__sub {
    margin-block-start: var(--space-4);
  }

  .hero__actions {
    margin-block-start: var(--space-5);
  }

  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-2);
    row-gap: var(--space-1);
    margin-block-start: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .hero__proof li {
    white-space: nowrap;
  }

  /* Separador no fim do item: a quebra nunca começa uma linha com "·". */
  .hero__proof li:not(:last-child)::after {
    content: '·';
    margin-inline-start: var(--space-2);
    color: var(--color-border-strong);
  }

  .hero__email { margin-block-start: var(--space-3); font-size: var(--text-sm); color: var(--color-text-muted); }

  .hero__facts {
    align-self: start;
    padding: var(--space-5);
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .hero__fact {
    display: flex;
    justify-content: space-between;
    align-items: last baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .hero__fact:first-child {
    padding-block-start: 0;
  }

  .hero__fact:last-child {
    padding-block-end: 0;
  }

  .hero__fact + .hero__fact {
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .hero__fact dt {
    font-weight: var(--weight-medium);
  }

  /* No painel o valor fica no tamanho do corpo (§7.1: tnum, 600, à direita). */
  .hero__fact dd :global(.price__value) {
    font-size: var(--text-base);
  }

  @media (min-width: 64em) {
    .hero {
      padding-block: var(--space-9);
    }

    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-gutter);
    }

    .hero__text {
      grid-column: 1 / span 8;
    }

    /* Alinhado ao topo do H1 (abaixo do eyebrow). */
    .hero__facts {
      grid-column: 9 / -1;
      margin-block-start: calc(var(--text-sm) * 1.3 + var(--space-3));
    }
  }
</style>
