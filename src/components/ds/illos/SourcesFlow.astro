---
/**
 * SourcesFlow (DESIGN-2026-11 §6.13): diagrama "de onde vêm os dados → cérebro → áreas".
 * As fontes e as áreas são TEXTO de verdade (duas listas); linhas, pontos que correm e o núcleo
 * pulsante são decorativos (aria-hidden). Desktop: três colunas; celular: de cima para baixo.
 *
 * <SourcesFlow inTitle="O que entra na base" inputs={[…]} core="Cérebro da operação" outTitle="Para cada área" outputs={[…]} />
 *
 * Motion: entra por rolagem (fontes da esquerda, núcleo, áreas da direita). O fluxo dos pontos só roda
 * com a figura na tela ([data-loop] → .is-on, src/scripts/motion.ts) e sem movimento reduzido.
 * Só transform/opacity. Sem JS: o diagrama completo, parado.
 */
interface Props {
  inTitle: string;
  inputs: string[];
  core: string;
  coreNote?: string;
  outTitle: string;
  outputs: string[];
  id?: string;
  /** Fundo do quadro: surface (em seção muted, padrão) ou muted (em seção branca). */
  tone?: 'surface' | 'muted';
  class?: string;
}

const { inTitle, inputs, core, coreNote, outTitle, outputs, id = 'sf', tone = 'surface', class: className } = Astro.props;
---

<div class:list={['sf', `sf--${tone}`, className]} data-reveal="rise" data-loop>
  <div class="sf__col sf__col--in">
    <p class="sf__title" id={`${id}-in`}>{inTitle}</p>
    <ul class="sf__list sf__list--in" role="list" aria-labelledby={`${id}-in`}>
      {inputs.map((item, k) => <li style={`--k:${k}`}>{item}</li>)}
    </ul>
  </div>
  <div class="sf__link" aria-hidden="true"><span class="sf__pulse"></span><span class="sf__pulse" style="--k:2"></span></div>
  <div class="sf__core">
    <span class="sf__orb" aria-hidden="true">
      <span class="sf__ring"></span>
      <span class="sf__ring" style="--k:1"></span>
      <svg viewBox="0 0 48 48" focusable="false">
        <path d="M24 8v8M24 32v8M8 24h8M32 24h8M12.7 12.7l5.6 5.6M29.7 29.7l5.6 5.6M35.3 12.7l-5.6 5.6M18.3 29.7l-5.6 5.6" />
        <circle cx="24" cy="24" r="6" />
      </svg>
    </span>
    <p class="sf__core-label">{core}</p>
    {coreNote && <p class="sf__core-note">{coreNote}</p>}
  </div>
  <div class="sf__link sf__link--out" aria-hidden="true"><span class="sf__pulse" style="--k:1"></span><span class="sf__pulse" style="--k:3"></span></div>
  <div class="sf__col sf__col--out">
    <p class="sf__title" id={`${id}-out`}>{outTitle}</p>
    <ul class="sf__list sf__list--out" role="list" aria-labelledby={`${id}-out`}>
      {outputs.map((item, k) => <li style={`--k:${k}`}>{item}</li>)}
    </ul>
  </div>
</div>

<style>
  .sf {
    --sf-stub: 1.5rem;
    --sf-line: var(--color-border-strong);
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    padding: var(--space-6) var(--space-4);
    border-radius: var(--radius-xl);
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border-subtle);
    min-inline-size: 0;
  }

  .sf--muted {
    background-color: var(--color-surface-muted);
  }

  .sf--muted .sf__list--in li {
    background-color: var(--color-surface);
  }

  .sf__col {
    display: grid;
    gap: var(--space-3);
    inline-size: 100%;
    min-inline-size: 0;
  }

  .sf__title {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-align: center;
  }

  .sf__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sf__list li {
    position: relative;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-full);
    border: var(--border-width) solid var(--color-border);
    background-color: var(--color-bg);
    font-size: var(--text-sm);
    line-height: 1.3;
    text-wrap: pretty;
  }

  .sf__list--out li {
    border-color: transparent;
    background-color: var(--color-accent-subtle);
    color: var(--color-accent-text);
    font-weight: var(--weight-medium);
  }

  /* Ligação vertical (celular): linha com pontos que descem. */
  .sf__link {
    position: relative;
    inline-size: 2px;
    block-size: 2.75rem;
    background-color: var(--sf-line);
    border-radius: 2px;
    overflow: hidden;
  }

  .sf__pulse {
    position: absolute;
    inset-inline-start: -2px;
    inset-block-start: -6px;
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background-color: var(--color-accent);
    opacity: 0;
  }

  .sf__core {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    text-align: center;
  }

  .sf__orb {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 5.5rem;
    block-size: 5.5rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--color-accent) 70%, #fff), var(--color-accent) 70%);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--color-accent) 35%, transparent);
    color: var(--color-on-accent);
  }

  .sf__orb svg {
    inline-size: 55%;
    block-size: 55%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.25;
    stroke-linecap: round;
  }

  .sf__ring {
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    border: 2px solid var(--color-accent);
    opacity: 0;
  }

  .sf__core-label {
    font-size: var(--text-title);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-title);
    max-inline-size: 14ch;
    line-height: var(--leading-snug);
  }

  .sf__core-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-inline-size: 22ch;
  }

  /* ---------- Desktop: três colunas, fontes → núcleo → áreas ---------- */
  @media (min-width: 64em) {
    .sf {
      grid-template-columns: minmax(0, 1fr) 4.5rem auto 4.5rem minmax(0, 1fr);
      align-items: center;
      gap: 0;
      padding: var(--space-8) var(--space-7);
    }

    .sf__title {
      text-align: start;
    }

    .sf__col--out .sf__title {
      padding-inline-start: var(--sf-stub);
    }

    .sf__list {
      display: grid;
      gap: var(--space-2);
      position: relative;
    }

    .sf__list li {
      border-radius: var(--radius-md);
    }

    .sf__list--in {
      padding-inline-end: var(--sf-stub);
    }

    .sf__list--out {
      padding-inline-start: var(--sf-stub);
    }

    /* Barramento vertical e o "toco" de cada item até ele. */
    .sf__list::before {
      content: '';
      position: absolute;
      inset-block: 1.1rem;
      inline-size: 2px;
      border-radius: 2px;
      background-color: var(--sf-line);
    }

    .sf__list--in::before {
      inset-inline-end: 0;
    }

    .sf__list--out::before {
      inset-inline-start: 0;
    }

    .sf__list li::after {
      content: '';
      position: absolute;
      inset-block-start: 50%;
      inline-size: var(--sf-stub);
      block-size: 2px;
      background-color: var(--sf-line);
    }

    .sf__list--in li::after {
      inset-inline-start: 100%;
    }

    .sf__list--out li::after {
      inset-inline-end: 100%;
    }

    /* Ponto que corre no toco (fontes → barramento; barramento → áreas). */
    .sf__list li::before {
      content: '';
      position: absolute;
      inset-block-start: calc(50% - 2px);
      inline-size: 6px;
      block-size: 6px;
      border-radius: 50%;
      background-color: var(--color-accent);
      opacity: 0;
      z-index: 1;
    }

    .sf__list--in li::before {
      inset-inline-start: 100%;
    }

    .sf__list--out li::before {
      inset-inline-start: calc(-1 * var(--sf-stub));
    }

    .sf__link {
      inline-size: 100%;
      block-size: 2px;
    }

    .sf__pulse {
      inset-block-start: -2px;
      inset-inline-start: -6px;
    }

    .sf__orb {
      inline-size: 7.5rem;
      block-size: 7.5rem;
    }

    .sf__core {
      padding-inline: var(--space-4);
    }
  }

  /* ---------- Movimento ---------- */
  @media (prefers-reduced-motion: no-preference) {
    :global(.sf.is-anim) .sf__list li {
      animation: sf-in var(--motion-reveal) var(--motion-ease) backwards;
      animation-delay: calc(200ms + var(--k, 0) * 60ms);
    }

    :global(.sf.is-anim) .sf__list--out li {
      animation-delay: calc(700ms + var(--k, 0) * 60ms);
    }

    :global(.sf.is-anim) .sf__orb {
      animation: sf-orb 1s var(--motion-ease-out) 450ms backwards;
    }

    :global(.sf.is-on) .sf__ring {
      animation: sf-ring 2.8s var(--motion-ease-out) infinite;
      animation-delay: calc(var(--k, 0) * 1.4s);
    }

    :global(.sf.is-on) .sf__pulse {
      animation: sf-down 2.2s var(--motion-ease-in-out) infinite;
      animation-delay: calc(var(--k, 0) * 0.55s);
    }

    @media (min-width: 64em) {
      :global(.sf.is-on) .sf__pulse {
        animation-name: sf-right;
      }

      :global(.sf.is-on) .sf__list li::before {
        animation: sf-stub 2.6s var(--motion-ease-in-out) infinite;
        animation-delay: calc(var(--k, 0) * 0.37s);
      }
    }
  }

  /* Texto entra por máscara, sem opacidade (contraste final desde o 1º quadro). */
  @keyframes sf-in {
    from {
      clip-path: inset(0 100% 0 0 round var(--radius-full));
      transform: translateY(8px);
    }

    to {
      clip-path: inset(0 0 0 0 round var(--radius-full));
    }
  }

  @keyframes sf-orb {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }

  @keyframes sf-ring {
    0% {
      opacity: 0.55;
      transform: scale(1);
    }

    100% {
      opacity: 0;
      transform: scale(1.7);
    }
  }

  @keyframes sf-down {
    0% {
      opacity: 0;
      transform: translateY(0);
    }

    20%,
    80% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translateY(3.25rem);
    }
  }

  @keyframes sf-right {
    0% {
      opacity: 0;
      transform: translateX(0);
    }

    20%,
    80% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translateX(4.75rem);
    }
  }

  @keyframes sf-stub {
    0%,
    55% {
      opacity: 0;
      transform: translateX(-4px);
    }

    65% {
      opacity: 1;
    }

    90% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translateX(calc(var(--sf-stub) - 2px));
    }
  }
</style>
