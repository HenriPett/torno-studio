---
/**
 * HelpFlow (DESIGN-2026-11 §6.13): "onde entramos", área por área. Cada linha é um mini antes → depois
 * (o problema de hoje, o que a Torno coloca no lugar) e o indicador medido no piloto ("Medimos: …"),
 * com a mini-ilustração da área (decorativa). Texto real em <ol>; nada promete valor.
 *
 * <HelpFlow items={[{ area, problem, whatWeDo, measure }]} />
 *
 * Motion: cada linha entra por rolagem; dentro dela o "depois" chega depois do "hoje" e o medidor enche.
 */
import AreaIllo from './AreaIllo.astro';

export interface HelpItem {
  area: string;
  problem: string;
  whatWeDo: string;
  measure: string;
}

interface Props {
  items: HelpItem[];
  labels?: { before: string; after: string; measure: string };
  class?: string;
}

const { items, labels = { before: 'Hoje', after: 'Com a Torno', measure: 'Medimos' }, class: className } = Astro.props;
---

<ol class:list={['hf', className]} role="list" data-reveal-stagger>
  {
    items.map((item, k) => (
      <li class="hf__row">
        <div class="hf__head">
          <span class="hf__num tnum" aria-hidden="true">
            {String(k + 1).padStart(2, '0')}
          </span>
          <h3 class="title hf__area">{item.area}</h3>
          <AreaIllo name={item.area} class="hf__illo" />
        </div>
        <div class="hf__flow">
          <div class="hf__box hf__box--before">
            <p class="hf__tag">
              <span class="hf__dot" aria-hidden="true" />
              {labels.before}
            </p>
            <p class="hf__text">{item.problem}</p>
          </div>
          <span class="hf__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path d="M4 12h15m-5-5 5 5-5 5" />
            </svg>
          </span>
          <div class="hf__box hf__box--after">
            <p class="hf__tag">
              <span class="hf__check" aria-hidden="true">
                <svg viewBox="0 0 16 16" focusable="false">
                  <path d="m4 8.5 2.5 2.5L12 5.5" />
                </svg>
              </span>
              {labels.after}
            </p>
            <p class="hf__text">{item.whatWeDo}</p>
          </div>
        </div>
        <p class="hf__measure">
          <span class="hf__gauge" aria-hidden="true">
            <svg viewBox="0 0 32 20" focusable="false">
              <path class="hf__gauge-track" d="M4 17a12 12 0 0 1 24 0" />
              <path class="hf__gauge-fill" pathLength="1" d="M4 17a12 12 0 0 1 24 0" />
              <path class="hf__gauge-needle" d="M16 17l6-7" />
            </svg>
          </span>
          <span>
            <strong>{labels.measure}:</strong> {item.measure}
          </span>
        </p>
      </li>
    ))
  }
</ol>

<style>
  .hf {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hf__row {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius-xl);
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border-subtle);
    min-inline-size: 0;
  }

  .hf__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .hf__num {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-accent-text);
  }

  .hf__head :global(.hf__illo) {
    display: none;
  }

  .hf__flow {
    display: grid;
    gap: var(--space-2);
  }

  .hf__box {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
  }

  .hf__box--before {
    background-color: var(--color-bg-muted);
  }

  .hf__box--after {
    background-color: var(--color-accent-subtle);
  }

  .hf__tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .hf__box--after .hf__tag {
    color: var(--color-accent-text);
  }

  .hf__dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-warn-text);
  }

  .hf__check {
    display: grid;
    place-items: center;
    inline-size: 1rem;
    block-size: 1rem;
    border-radius: 50%;
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .hf__check svg {
    inline-size: 0.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hf__text {
    font-size: var(--text-sm);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .hf__arrow {
    display: grid;
    place-items: center;
    color: var(--color-text-muted);
    transform: rotate(90deg);
    block-size: 1.25rem;
  }

  .hf__arrow svg {
    inline-size: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hf__measure {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  .hf__gauge svg {
    display: block;
    inline-size: 2rem;
    fill: none;
    stroke-linecap: round;
  }

  .hf__gauge-track {
    stroke: var(--color-border);
    stroke-width: 3;
  }

  .hf__gauge-fill {
    stroke: var(--color-ok-text);
    stroke-width: 3;
    stroke-dasharray: 0.62 1;
  }

  .hf__gauge-needle {
    stroke: var(--color-text);
    stroke-width: 2;
    transform-box: view-box;
    transform-origin: 16px 17px;
  }

  @media (min-width: 64em) {
    .hf__row {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: var(--space-4) var(--space-6);
      padding: var(--space-6);
    }

    .hf__head {
      grid-row: span 2;
      align-content: start;
    }

    .hf__head :global(.hf__illo) {
      display: block;
      grid-column: 1 / -1;
      margin-block-start: var(--space-2);
    }

    .hf__flow {
      grid-template-columns: minmax(0, 1fr) 1.5rem minmax(0, 1fr);
      align-items: stretch;
    }

    .hf__arrow {
      transform: none;
      block-size: auto;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.hf__row.is-anim) .hf__box--after {
      animation: hf-in var(--motion-reveal) var(--motion-ease) 450ms backwards;
    }

    :global(.hf__row.is-anim) .hf__arrow svg {
      animation: hf-arrow 0.7s var(--motion-ease-out) 350ms backwards;
    }

    :global(.hf__row.is-anim) .hf__gauge-needle {
      animation: hf-needle var(--motion-long) var(--motion-ease-out) 700ms backwards;
    }
  }

  @keyframes hf-in {
    from {
      opacity: 0;
      transform: translateX(-12px);
    }
  }

  @keyframes hf-arrow {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
  }

  @keyframes hf-needle {
    from {
      transform: rotate(-110deg);
    }
  }
</style>
