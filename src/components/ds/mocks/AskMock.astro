---
/**
 * AskMock (DESIGN-2026-11 §6.12): ilustração do "cérebro da operação" respondendo uma pergunta de
 * fábrica com citações de fonte. HTML/CSS puro, sem imagem. Selo "Ilustração" obrigatório (MockFrame).
 *
 * <AskMock locale="pt-BR" />                         → exemplo padrão do idioma
 * <AskMock locale="en" question="…" answer="…" sources={[…]} asker="…" />
 * <AskMock locale="pt-BR" id="demo" tabsLabel="…" items={[{ label, asker, question, answer, sources }, …]} />
 *   → demo interativa (DESIGN §9): abas ARIA por área; cada aba troca a pergunta e a resposta do mock.
 *
 * Motion (src/scripts/motion.ts, [data-ask]): a pergunta é digitada na caixa, sobe como balão, a resposta
 * aparece e as fontes entram depois. Toca sozinha uma vez ao entrar na tela. Sem JS ou com movimento
 * reduzido: o primeiro exemplo completo, sem abas (sem JS) ou com troca seca (movimento reduzido).
 * O mock continua UMA imagem (role="img"); o nome acessível acompanha a aba ativa.
 */
import { getChrome } from '../../../content/chrome';
import type { Locale } from '../../../lib/i18n';
import MockFrame from './MockFrame.astro';

export interface AskSource {
  title: string;
  detail: string;
}

export interface AskItem {
  /** Rótulo da aba. */
  label: string;
  asker?: string;
  question: string;
  answer: string;
  sources: AskSource[];
}

interface Props {
  locale: Locale;
  question?: string;
  /** Resposta; marcadores [1], [2] viram selos de citação. */
  answer?: string;
  sources?: AskSource[];
  asker?: string;
  label?: string;
  caption?: string;
  stage?: 'muted' | 'surface' | 'none';
  /** Vários exemplos com abas (≥ 2). Substitui question/answer/sources/asker. */
  items?: AskItem[];
  /** Nome acessível da lista de abas. */
  tabsLabel?: string;
  /** Prefixo dos ids das abas (único na página). */
  id?: string;
}

const defaults = {
  'pt-BR': {
    app: 'Assistente da operação',
    asker: 'Supervisora de produção · Linha 2',
    question: 'Qual a faixa de temperatura da zona 3 para o PP copolímero depois da última revisão?',
    answer:
      'Entre 210 °C e 230 °C, com rosca a 45 rpm [1]. A revisão C baixou o limite superior de 240 °C para 230 °C por causa de manchas no lote 0912 [2].',
    sources: [
      { title: 'Ficha técnica 4471, rev. C', detail: 'Parâmetros de processo · p. 2' },
      { title: 'Relatório de não conformidade RNC-0912', detail: 'Causa e ação corretiva' },
    ],
    sourcesTitle: 'Fontes',
    input: 'Pergunte sobre máquinas, fichas, pedidos…',
    description:
      'tela de um assistente interno. Uma supervisora pergunta a faixa de temperatura de uma extrusora; a resposta cita a ficha técnica 4471, revisão C, e um relatório de não conformidade.',
  },
  en: {
    app: 'Operations assistant',
    asker: 'Production supervisor · Line 2',
    question: 'What is the zone 3 temperature range for PP copolymer after the latest revision?',
    answer:
      'Between 210 °C and 230 °C, with the screw at 45 rpm [1]. Revision C lowered the upper limit from 240 °C to 230 °C after streaks on batch 0912 [2].',
    sources: [
      { title: 'Technical sheet 4471, rev. C', detail: 'Process parameters · p. 2' },
      { title: 'Non-conformance report NCR-0912', detail: 'Root cause and corrective action' },
    ],
    sourcesTitle: 'Sources',
    input: 'Ask about machines, sheets, orders…',
    description:
      'an internal assistant screen. A supervisor asks for an extruder temperature range; the answer cites technical sheet 4471, revision C, and a non-conformance report.',
  },
} as const;

const { locale, caption, stage, tabsLabel, id = 'ask' } = Astro.props;
const d = defaults[locale];
const label = Astro.props.label ?? getChrome(locale).common.illustration;
const custom = Boolean(Astro.props.question || Astro.props.items);
const items: AskItem[] = Astro.props.items?.length
  ? Astro.props.items
  : [
      {
        label: '',
        asker: Astro.props.asker ?? d.asker,
        question: Astro.props.question ?? d.question,
        answer: Astro.props.answer ?? d.answer,
        sources: Astro.props.sources ?? [...d.sources],
      },
    ];
const tabs = items.length > 1;
const threads = items.map((item) => ({
  ...item,
  asker: item.asker ?? d.asker,
  parts: item.answer.split(/(\[\d+\])/g).filter(Boolean),
  description: custom ? `${item.question} — ${item.answer}` : d.description,
}));
const description = threads[0]!.description;
---

<div class:list={['ask-demo', tabs && 'ask-demo--tabs']} data-ask>
  {
    tabs && (
      <div class="ask-demo__tabs" role="tablist" aria-label={tabsLabel}>
        <span class="ask-demo__ind" aria-hidden="true" />
        {items.map((item, k) => (
          <button
            type="button"
            role="tab"
            class="ask-demo__tab"
            id={`${id}-tab-${k}`}
            aria-selected={k === 0 ? 'true' : 'false'}
            aria-controls={`${id}-panel`}
            tabindex={k === 0 ? 0 : -1}
          >
            {item.label}
          </button>
        ))}
      </div>
    )
  }
  <div
    class="ask-demo__panel"
    id={tabs ? `${id}-panel` : undefined}
    role={tabs ? 'tabpanel' : undefined}
    aria-labelledby={tabs ? `${id}-tab-0` : undefined}
    tabindex={tabs ? 0 : undefined}
  >
    <MockFrame label={label} description={description} caption={caption} stage={stage}>
      <div class="ask">
        <div class="ask__bar">
          <span class="ask__logo" aria-hidden="true"></span>
          <span class="ask__app">{d.app}</span>
        </div>
        <div class="ask__threads">
          {
            threads.map((t, k) => (
              <div class="ask__thread" data-thread data-label={`${label}: ${t.description}`} hidden={k > 0}>
                <div class="ask__q">
                  <p class="ask__who">{t.asker}</p>
                  <p class="ask__bubble">{t.question}</p>
                </div>
                <div class="ask__a">
                  <span class="ask__spark" aria-hidden="true" />
                  <div class="ask__a-body">
                    <p class="ask__text">
                      {t.parts.map((part) =>
                        /^\[\d+\]$/.test(part) ? <span class="ask__cite tnum">{part.slice(1, -1)}</span> : part,
                      )}
                    </p>
                    <p class="ask__sources-title">{d.sourcesTitle}</p>
                    <ol class="ask__sources">
                      {t.sources.map((source, index) => (
                        <li class="ask__source" style={`--k:${index}`}>
                          <span class="ask__cite tnum">{index + 1}</span>
                          <span class="ask__doc" aria-hidden="true" />
                          <span class="ask__source-text">
                            <strong>{source.title}</strong>
                            <span>{source.detail}</span>
                          </span>
                        </li>
                      ))}
                    </ol>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
        <div class="ask__input">
          <span class="ask__field">
            <span class="ask__placeholder">{d.input}</span>
            <span class="ask__typing" aria-hidden="true"></span>
          </span>
          <span class="ask__send" aria-hidden="true">
            <svg viewBox="0 0 16 16"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" /></svg>
          </span>
        </div>
      </div>
    </MockFrame>
  </div>
</div>

<style>
  .ask {
    display: flex;
    flex-direction: column;
  }

  .ask__bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-block-end: var(--border-width) solid var(--color-border-subtle);
    font-weight: var(--weight-semibold);
  }

  .ask__logo {
    inline-size: 14px;
    block-size: 14px;
    border-radius: 50%;
    border: 3px solid var(--color-accent);
  }

  .ask__thread {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5) var(--space-4);
  }

  .ask__q {
    display: grid;
    justify-items: end;
    gap: var(--space-1);
    padding-inline-start: 12%;
  }

  .ask__who {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .ask__bubble {
    padding: var(--space-3) var(--space-4);
    border-radius: 18px 18px 4px 18px;
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .ask__a {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: var(--space-3);
  }

  .ask__spark {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    border-radius: 50%;
    border: 4px solid var(--color-accent);
    background: radial-gradient(circle at center, var(--color-accent) 0 3px, transparent 3.5px);
  }

  .ask__text {
    font-size: var(--text-base);
    line-height: 1.5;
  }

  .ask__cite {
    display: inline-grid;
    place-items: center;
    min-inline-size: 1.15rem;
    block-size: 1.15rem;
    margin-inline: 0.15em;
    padding-inline: 0.25rem;
    border-radius: var(--radius-full);
    background-color: var(--color-accent-subtle);
    color: var(--color-accent-text);
    font-size: 0.6875rem;
    font-weight: var(--weight-semibold);
    vertical-align: 0.15em;
  }

  .ask__sources-title {
    margin-block: var(--space-4) var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
  }

  .ask__sources {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .ask__source {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: var(--border-width) solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background-color: var(--color-surface-muted);
  }

  .ask__source .ask__cite {
    margin: 0;
    vertical-align: 0;
  }

  .ask__doc {
    inline-size: 14px;
    block-size: 17px;
    border-radius: 2px;
    border: 1.5px solid var(--color-text-muted);
    background: linear-gradient(var(--color-text-muted), var(--color-text-muted)) 3px 5px / 6px 1.5px no-repeat,
      linear-gradient(var(--color-text-muted), var(--color-text-muted)) 3px 9px / 6px 1.5px no-repeat;
  }

  .ask__source-text {
    display: grid;
    min-inline-size: 0;
  }

  .ask__source-text strong {
    font-weight: var(--weight-semibold);
  }

  .ask__source-text span {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .ask__input {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin: 0 var(--space-4) var(--space-4);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
  }

  .ask__field {
    position: relative;
    display: grid;
    min-inline-size: 0;
    flex: 1 1 auto;
  }

  .ask__placeholder,
  .ask__typing {
    grid-area: 1 / 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .ask__typing {
    text-overflow: clip;
    color: var(--color-text);
  }

  .ask__typing:empty {
    display: none;
  }

  .ask__typing.is-typing::after {
    content: "";
    display: inline-block;
    inline-size: 2px;
    block-size: 1.1em;
    margin-inline-start: 1px;
    vertical-align: -0.2em;
    background: var(--color-accent);
    animation: ask-caret 1s steps(1) infinite;
  }

  .ask__field:has(.ask__typing:not(:empty)) .ask__placeholder {
    visibility: hidden;
  }

  @keyframes ask-caret {
    50% {
      opacity: 0;
    }
  }

  /* ---------- Demo com abas (DESIGN §9) ---------- */

  .ask-demo {
    display: grid;
    gap: var(--space-4);
    min-inline-size: 0;
  }

  /* Abas só com JS (sem JS fica o 1º exemplo, completo). */
  .ask-demo__tabs {
    display: none;
  }

  :global(html.js-motion) .ask-demo__tabs {
    position: relative;
    display: flex;
    justify-self: center;
    gap: 2px;
    max-inline-size: 100%;
    padding: 4px;
    overflow-x: auto;
    border-radius: var(--radius-full);
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border-subtle);
    scrollbar-width: none;
    scroll-padding-inline: var(--space-4);
  }

  .ask-demo__tabs::-webkit-scrollbar {
    display: none;
  }

  .ask-demo__tab {
    position: relative;
    z-index: 1;
    flex: none;
    min-block-size: var(--tap-min);
    padding-inline: var(--space-4);
    border: 0;
    border-radius: var(--radius-full);
    background: none;
    color: var(--color-text-muted);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    cursor: pointer;
    transition: color var(--motion-short) var(--motion-ease-in-out), background-color var(--motion-short) var(--motion-ease-in-out);
  }

  .ask-demo__tab[aria-selected="true"] {
    color: var(--color-on-accent);
    background-color: var(--color-accent);
  }

  .ask-demo__tab:focus-visible {
    outline-offset: -2px;
    border-radius: var(--radius-full);
  }

  @media (hover: hover) {
    .ask-demo__tab[aria-selected="false"]:hover {
      color: var(--color-text);
    }
  }

  /* Indicador que desliza entre as abas (posição vem do JS). */
  .ask-demo__ind {
    position: absolute;
    z-index: 0;
    inset-block: 4px;
    inset-inline-start: 0;
    inline-size: 0;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    opacity: 0;
    transition:
      transform 0.5s var(--motion-ease),
      width 0.5s var(--motion-ease);
  }

  .has-ind .ask-demo__ind {
    opacity: 1;
  }

  .has-ind .ask-demo__tab[aria-selected="true"] {
    background-color: transparent;
  }

  .ask-demo__panel {
    min-inline-size: 0;
    border-radius: var(--radius-xl);
  }

  /* Todas as conversas na mesma célula: a altura é a da maior, trocar de aba não mexe no layout. */
  :global(html.js-motion) .ask__threads {
    display: grid;
  }

  :global(html.js-motion) .ask__thread {
    grid-area: 1 / 1;
  }

  :global(html.js-motion) .ask__thread[hidden] {
    display: grid;
    visibility: hidden;
  }

  /* ---------- Sequência: digitando → enviada → pensando → resposta → fontes ---------- */

  /* Texto entra por máscara (clip-path) e não por opacidade: o contraste é o final desde o 1º quadro (axe e
     Lighthouse medem no meio da sequência, que agora toca na 1ª dobra). Escondido = visibility: hidden. */
  .ask__q,
  .ask__spark,
  .ask__text,
  .ask__sources-title,
  .ask__sources,
  .ask__source {
    transition:
      opacity 0.45s var(--motion-ease),
      clip-path 0.6s var(--motion-ease),
      visibility 0s,
      transform 0.6s var(--motion-ease);
  }

  /* Ao começar (troca de aba), esconde na hora: nada de a resposta anterior "sumir" devagar. */
  .ask__thread[data-state="typing"] * {
    transition: none;
  }

  /* Durante a sequência a máscara existe sempre (aberta = inset(-1rem)), para interpolar. */
  .ask__thread[data-state] :is(.ask__q, .ask__text, .ask__sources-title, .ask__sources, .ask__source) {
    clip-path: inset(-1rem);
  }

  .ask__thread[data-state] .ask__a-body > *,
  .ask__thread[data-state] .ask__source {
    visibility: hidden;
    clip-path: inset(0 0 100% 0);
    transform: translateY(0.5rem);
  }

  .ask__thread[data-state="typing"] .ask__q {
    visibility: hidden;
    clip-path: inset(0 0 100% 0);
    transform: translateY(1rem) scale(0.97);
    transform-origin: 100% 100%;
  }

  .ask__thread[data-state="typing"] .ask__spark,
  .ask__thread[data-state="sent"] .ask__spark {
    opacity: 0;
    transform: scale(0.6);
  }

  .ask__thread[data-state="thinking"] .ask__spark {
    animation: ask-think 0.75s var(--motion-ease-in-out) infinite alternate;
  }

  .ask__thread:is([data-state="answer"], [data-state="sources"]) .ask__a-body > .ask__text {
    visibility: visible;
    clip-path: inset(-1rem);
    transform: none;
  }

  .ask__thread:is([data-state="answer"], [data-state="sources"]) .ask__text .ask__cite {
    animation: ask-cite 0.5s var(--motion-ease-out) 0.35s backwards;
  }

  .ask__thread[data-state="sources"] .ask__a-body > :is(.ask__sources-title, .ask__sources),
  .ask__thread[data-state="sources"] .ask__sources > .ask__source {
    visibility: visible;
    clip-path: inset(-1rem);
    transform: none;
  }

  .ask__thread[data-state="sources"] .ask__sources > .ask__source {
    transition-delay: calc(120ms + var(--k, 0) * 120ms);
  }

  @keyframes ask-think {
    to {
      transform: scale(0.82);
    }
  }

  @keyframes ask-cite {
    from {
      transform: scale(0.4);
    }
  }

  .ask__send {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: 50%;
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .ask__send svg {
    inline-size: 1rem;
    block-size: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
