---
/**
 * Moldura comum dos mocks de interface (uso interno de ds/mocks). Garante a regra de honestidade:
 * selo visível "Ilustração"/"Illustration" em todo mock, e o mock inteiro exposto como UMA imagem
 * (role="img") com nome acessível "<selo>: <descrição>". Não é tela de cliente.
 */
interface Props {
  label: string;
  description: string;
  caption?: string | undefined;
  /** Fundo em volta da janela: muted (padrão), surface (em seção muted) ou none. */
  stage?: 'muted' | 'surface' | 'none' | undefined;
  class?: string | undefined;
}

const { label, description, caption, stage = 'muted', class: className } = Astro.props;
---

<figure class:list={['ds-mock', `ds-mock--${stage}`, className]}>
  <div class="ds-mock__stage">
    <div class="ds-mock__window" role="img" aria-label={`${label}: ${description}`}>
      <slot />
    </div>
    <span class="ds-mock__seal" aria-hidden="true">{label}</span>
  </div>
  {caption && <figcaption class="caption ds-mock__caption">{caption}</figcaption>}
</figure>

<style>
  .ds-mock {
    min-inline-size: 0;
    font-size: var(--text-sm);
    line-height: 1.45;
    letter-spacing: -0.003em;
  }

  .ds-mock__stage {
    position: relative;
    border-radius: var(--radius-xl);
    padding: clamp(var(--space-3), 0.25rem + 3vw, var(--space-7));
    padding-block-start: clamp(var(--space-7), 2rem + 2vw, var(--space-8));
  }

  .ds-mock--muted .ds-mock__stage {
    background-color: var(--color-surface-muted);
  }

  .ds-mock--surface .ds-mock__stage {
    background-color: var(--color-surface);
  }

  .ds-mock--none .ds-mock__stage {
    padding: var(--space-7) 0 0;
  }

  .ds-mock__window {
    overflow: hidden;
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-raised);
    border: var(--border-width) solid var(--color-border-subtle);
    box-shadow: var(--shadow-lg);
    color: var(--color-text);
  }

  .ds-mock__seal {
    position: absolute;
    inset-block-start: var(--space-3);
    inset-inline-start: 50%;
    transform: translateX(-50%);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
    background-color: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .ds-mock__caption {
    margin-block-start: var(--space-3);
    text-align: center;
  }
</style>
