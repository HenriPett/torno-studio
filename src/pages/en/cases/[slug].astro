---
import CaseStudy from '../../../components/cases/CaseStudy.astro';
import { caseStudies, type CaseSlug } from '../../../content/cases';
export function getStaticPaths() {
 return Object.keys(caseStudies['en']).map(slug => ({ params: { slug }, props: { slug } }));
}
interface Props { slug: CaseSlug }
const { slug } = Astro.props;
---
<CaseStudy locale="en" slug={slug} />
