---
import CaseStudy from '../../../components/cases/CaseStudy.astro';
import { caseSlugs, type CaseSlug } from '../../../content/cases';
export function getStaticPaths() {
  return caseSlugs.map((slug) => ({ params: { slug }, props: { slug } }));
}
interface Props {
  slug: CaseSlug;
}
const { slug } = Astro.props;
---
<CaseStudy locale="en" slug={slug} />
