---
/**
 * 404 bilíngue (DESIGN §7.11): um só arquivo (a Netlify serve dist/404.html), bloco PT e bloco EN
 * lado a lado no desktop (empilhados no celular), cada um com seu `lang` e um só link. Sem ilustração.
 */
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Wordmark from '../components/ui/Wordmark.astro';
import { fill, getCopy, htmlLang, locales, pathFor } from '../lib/i18n';

const pt = getCopy('pt-BR');
---

<Base locale="pt-BR" title={pt.meta.notFound.title} description={pt.meta.notFound.description} noindex>
  <header class="nf-header">
    <div class="container nf-header__inner">
      <Wordmark href={pathFor('home', 'pt-BR')} />
    </div>
  </header>
  <main id="conteudo" class="nf-main" tabindex="-1">
    <div class="container nf">
      <p class="nf__code" aria-hidden="true">404</p>
      <div class="nf__blocks">
        {
          locales.map((locale) => {
            const copy = getCopy(locale);
            return (
              <section lang={htmlLang[locale]} class="nf__block">
                {locale === 'pt-BR' ? (
                  <h1 class="nf__title">{copy.notFound.title}</h1>
                ) : (
                  <h2 class="nf__title">{copy.notFound.title}</h2>
                )}
                <p class="nf__body">{fill(copy.notFound.body)}</p>
                <p>
                  <a class="link link--arrow link--target nf__link" href={pathFor('home', locale)}>
                    {copy.notFound.homeLink}
                  </a>
                </p>
              </section>
            );
          })
        }
      </div>
    </div>
  </main>
  <Footer locale="pt-BR" routeId="home" />
</Base>

<style>
  .nf-header {
    background-color: var(--color-bg);
    box-shadow: var(--shadow-header);
  }

  .nf-header__inner {
    display: flex;
    align-items: center;
    min-block-size: var(--header-height);
  }

  .nf-main {
    padding-block: var(--space-section);
  }

  .nf__code {
    font-size: clamp(5rem, 3rem + 9vw, 11rem);
    font-weight: var(--weight-display);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: var(--color-text-muted);
    font-feature-settings: var(--font-features-numeric);
  }

  .nf__blocks {
    display: grid;
    gap: var(--space-gutter);
    margin-block-start: var(--space-7);
  }

  .nf__block {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-6);
    background-color: var(--color-surface-muted);
    border-radius: var(--radius-xl);
  }

  .nf__title {
    font-size: var(--text-title-lg);
    font-weight: var(--weight-display);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-title);
    text-wrap: balance;
  }

  .nf__body {
    color: var(--color-text-muted);
    max-inline-size: 46ch;
    text-wrap: pretty;
  }

  .nf__link {
    margin-block-start: var(--space-2);
  }

  @media (min-width: 48em) {
    .nf__blocks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .nf__block {
      padding: var(--space-7);
    }
  }
</style>
