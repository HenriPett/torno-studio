# Copie para .env e ajuste. Só variáveis PUBLIC_* chegam ao site (são públicas: nada de segredo aqui).
# Referência: PLANO-DEV §1.3 e src/config/site.ts.

# Marca (fonte única para header, footer, <title>, meta e OG). Vazio -> "[Marca]". Na Netlify: Torno (F1).
PUBLIC_SITE_BRAND=

# URL pública, sem barra final. Vazio -> Netlify (URL em produção, DEPLOY_PRIME_URL em preview) ou http://localhost:4321.
PUBLIC_SITE_URL=

# Link do diagnóstico de 45 min (Cal.com/Calendly). OBRIGATÓRIO em CONTEXT=production na Netlify (o build falha).
PUBLIC_BOOKING_URL=

# E-mail público. OBRIGATÓRIO em CONTEXT=production na Netlify (o build falha). Vazio (preview/dev) -> a privacidade usa o LinkedIn.
PUBLIC_CONTACT_EMAIL=

# Perfis do fundador. Vazio -> valores do currículo (projeto-50k/base/), pendentes de confirmação (F6).
PUBLIC_LINKEDIN_URL=
PUBLIC_GITHUB_URL=

# Controlador dos dados na página de privacidade (F9): razão social/nome e CNPJ/CPF.
# OBRIGATÓRIOS em CONTEXT=production na Netlify (o build falha). Vazios -> linha do controlador oculta.
PUBLIC_LEGAL_NAME=
PUBLIC_LEGAL_ID=

# "true" só com autorização escrita da Loopt (BRIEFING §3, regra 3).
PUBLIC_LOOPT_AUTHORIZED=false

# "true" só quando houver depoimento real de cliente (BRIEFING §3, regra 5).
PUBLIC_SHOW_TESTIMONIALS=false

# "true" só em produção com domínio definitivo. Qualquer outro valor -> noindex.
PUBLIC_ALLOW_INDEXING=false

# Google Ads (docs/consent/SPEC.md). Só carrega depois do aceite de Publicidade no banner.
# Vazio -> nenhuma tag do Google carrega. Ex.: AW-934581192
PUBLIC_GADS_ID=
# Rótulo da conversão "Diagnóstico agendado" (send_to: <GADS_ID>/<label>). Vazio -> sem evento de conversão.
PUBLIC_GADS_CONV_LABEL=
